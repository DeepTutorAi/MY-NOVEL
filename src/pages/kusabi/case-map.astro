---
import KusabiBaseLayout from "../../layouts/kusabi/KusabiBaseLayout.astro";
import { withBase } from "../../utils/base-path";

// Nothing in this HTML names a room or an event. Questions and the plan come from
// the vault after the epilogue is finished (scripts/kusabi/case-map/case-map.ts).
const keys = ["1", "2", "3", "4", "5", "6", "7", "8", "9"];
---

<KusabiBaseLayout
  title="แผนผัง · บ้านคุซาบิบนเขาคุโระมิโซะ"
  description="โครงเรื่องทั้งเล่มและรายละเอียดที่นิยายไม่ได้เล่า เปิดได้หลังอ่านจบและตอบคำถามผ่าน"
  bodyClass="kusabi-case-map"
>
  <main class="kusabi-page casemap">
    <header class="kusabi-page-head">
      <p class="kusabi-kicker">Story Plan</p>
      <h1>แผนผัง</h1>
      <p data-map-lead>หน้านี้เฉลยทั้งเรื่อง จึงเปิดให้เฉพาะคนที่อ่านจบแล้ว</p>
    </header>

    <section class="map-locked" data-map-locked>
      <p>อ่านบทส่งท้ายจบก่อน แล้วแผงตัวเลขของหน้านี้จะเปิดให้ลอง</p>
      <a class="kusabi-strip" href={withBase("/kusabi/#kusabi-shelf")}>กลับชั้นเทป</a>
    </section>

    <section class="quiz" data-quiz hidden aria-labelledby="quiz-heading">
      <h2 id="quiz-heading">ตอบให้ได้สี่ข้อ แต่ละข้อจะให้เลขหนึ่งหลัก</h2>
      <p class="quiz-lead">ตอบผิดได้ไม่จำกัด ไม่มีอะไรหายไป ถ้าจำไม่ได้ลองกลับไปอ่านตามคำใบ้</p>
      <ol class="quiz-digits" data-quiz-digits aria-label="เลขที่ได้แล้ว"></ol>
      <form class="quiz-card" data-quiz-form>
        <label class="quiz-question" for="quiz-answer" data-quiz-text></label>
        <div class="quiz-row">
          <input id="quiz-answer" type="text" autocomplete="off" spellcheck="false" data-quiz-input />
          <button type="submit" class="kusabi-strip">ตอบ</button>
        </div>
        <p class="quiz-error" data-quiz-error role="status" hidden></p>
      </form>
    </section>

    <section class="keypad" data-keypad hidden aria-labelledby="keypad-heading">
      <h2 id="keypad-heading">กดเลขทั้งสี่ตามลำดับบนแผง</h2>
      <div class="keypad-panel">
        <div class="keypad-holes" aria-live="polite" data-keypad-holes>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="keypad-keys">
          {keys.map((key) => <button type="button" class="key" data-key={key}>{key}</button>)}
          <button type="button" class="key key-word" data-key-clear>ลบ</button>
          <button type="button" class="key" data-key="0">0</button>
          <button type="button" class="key key-word" data-key-enter>กด</button>
        </div>
      </div>
      <p class="quiz-error" data-keypad-error role="status" hidden>เลขไม่ตรงกับที่ได้มา ลองกดใหม่อีกครั้ง</p>
    </section>

    <section class="map-open" data-map-open hidden aria-label="โครงเรื่องและสิ่งที่นิยายไม่ได้เล่า">
      <section class="map-part map-short">
        <h2>คำตอบสั้นที่สุด</h2>
        <ul class="map-lines" data-short></ul>
      </section>

      <section class="map-part">
        <h2>โครงเรื่อง</h2>
        <div class="arcs" data-arcs></div>
      </section>

      <div class="map-columns">
        <section class="map-part">
          <h2>เวลาในคืนนั้น</h2>
          <ol class="night" data-night></ol>
        </section>
        <section class="map-part">
          <h2>ใครรู้อะไรเมื่อไร</h2>
          <ul class="knows" data-knows></ul>
        </section>
      </div>

      <section class="map-part">
        <h2>ม้วนเทปที่เรื่องเล่าถึง</h2>
        <ul class="ledger" data-ledger></ul>
      </section>

      <section class="map-part">
        <h2>เบาะแสที่วางไว้ตั้งแต่ต้น</h2>
        <p class="map-lead">ทุกข้ออยู่ในเนื้อเรื่องมาตลอด อ่านรอบแรกอาจผ่านตาไป</p>
        <ul class="clues" data-clues></ul>
      </section>

      <section class="map-only" aria-labelledby="only-here">
        <header class="map-only-head">
          <p class="kusabi-kicker">Only Here</p>
          <h2 id="only-here">สิ่งที่นิยายไม่ได้เล่า</h2>
          <p class="map-lead">เกร็ดเล็กเกร็ดน้อยจากตรงนี้ลงไปไม่อยู่ในบทไหนเลย และมีแค่ในหน้านี้</p>
        </header>

        <div data-facts></div>

        <section class="map-part">
          <h3>อีกฝั่งของเรื่อง: เขาเห็นอะไรในแต่ละช่วง</h3>
          <ol class="night" data-behind></ol>
        </section>

        <section class="map-part">
          <h3>รอยแผลเก่าของทั้งห้าคน</h3>
          <ul class="night" data-wounds></ul>
        </section>

        <section class="map-part">
          <h3>กระจกของเรียวยะ</h3>
          <ul class="map-lines" data-mirror></ul>
        </section>

        <section class="map-part">
          <h3>คำถามที่เรื่องไม่ได้ตอบตรง ๆ</h3>
          <dl class="answers" data-questions></dl>
        </section>

        <section class="map-part">
          <h3>ชื่อ ปี และรอยต่อ</h3>
          <ul class="map-lines" data-names></ul>
        </section>

        <section class="map-part" data-history-wrap hidden>
          <h3>ของที่ติดตัวเขามาจากปี 2009</h3>
          <div data-facts-late></div>
          <h3>ความจริงที่เขาหลบ</h3>
          <ul class="map-lines" data-truth></ul>
          <h3>ก่อนคืนนั้น</h3>
          <ol class="night" data-history></ol>
        </section>
        <p class="map-lead" data-history-hint>ยังมีอีกส่วนหนึ่ง จะเปิดเมื่ออ่านเรื่องเสริมตอนที่ 4 จบ</p>
      </section>
    </section>
  </main>

  <script>
    import { onPage } from "../../scripts/_shared/lifecycle";
    import { setupCaseMap } from "../../scripts/kusabi/case-map/case-map";

    onPage("kusabi-case-map", { bodyClass: "kusabi-case-map" }, () => setupCaseMap());
  </script>

  <style is:global>
    .map-locked {
      display: grid;
      gap: 1rem;
      justify-items: start;
      max-width: 34rem;
    }

    .map-locked p {
      margin: 0;
      color: var(--kusabi-ink-dim);
    }

    .quiz,
    .keypad {
      display: grid;
      gap: 0.9rem;
      max-width: 34rem;
    }

    .keypad {
      margin-top: 1.75rem;
    }

    .quiz h2,
    .keypad h2 {
      margin: 0;
      font-size: 1.2rem;
    }

    .quiz-lead {
      margin: 0;
      color: var(--kusabi-ink-dim);
      font-size: 0.9rem;
    }

    .quiz-digits {
      display: flex;
      gap: 6px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .quiz-digits li {
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 3rem;
      border: 1px solid var(--kusabi-stone-line);
      background: rgba(22, 19, 17, 0.9);
      color: var(--kusabi-ink-dim);
      font-family: var(--font-mono);
    }

    .quiz-digits li[data-done="true"] {
      background: var(--kusabi-label);
      color: var(--kusabi-label-ink);
      font-family: var(--font-hand);
      font-size: 1.3rem;
    }

    .quiz-card {
      display: grid;
      gap: 0.7rem;
      padding: 1rem;
      border: 1px solid var(--kusabi-stone-line);
      background: rgba(22, 19, 17, 0.92);
    }

    .quiz-question {
      font-size: 1.02rem;
      line-height: 1.6;
    }

    .quiz-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .quiz-row input {
      flex: 1 1 12rem;
      min-height: 44px;
      min-width: 0;
      padding: 0 0.75rem;
      border: 1px solid var(--kusabi-stone-3);
      background: rgba(0, 0, 0, 0.3);
      color: var(--kusabi-ink);
      font-family: var(--font-thai);
      font-size: 1rem;
    }

    .quiz-error {
      margin: 0;
      color: var(--kusabi-accent-bright);
      font-size: 0.88rem;
    }

    .keypad-panel {
      display: grid;
      gap: 0.8rem;
      justify-items: center;
      width: min(100%, 17rem);
      padding: 1rem;
      border: 1px solid var(--kusabi-stone-3);
      background: linear-gradient(180deg, #34302c, #1d1a17);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 12px 30px rgba(0, 0, 0, 0.45);
    }

    .keypad-holes {
      display: flex;
      gap: 8px;
    }

    .keypad-holes span {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background: #0b0908;
      box-shadow: inset 0 2px 4px #000;
      color: var(--kusabi-lamp);
      font-family: var(--font-mono);
    }

    .keypad-keys {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
      width: 100%;
    }

    .key {
      min-height: 48px;
      border: 1px solid rgba(0, 0, 0, 0.6);
      background: linear-gradient(180deg, #4a4540, #2e2a26);
      color: var(--kusabi-ink);
      font-family: var(--font-mono);
      font-size: 1.05rem;
      cursor: pointer;
    }

    .key:active {
      background: #25221f;
    }

    .key-word {
      font-family: var(--font-thai);
      font-size: 0.9rem;
    }

    .keypad[data-wrong="true"] .keypad-panel {
      animation: keypad-no 300ms ease-in-out 1;
    }

    @keyframes keypad-no {
      25% {
        transform: translateX(-5px);
      }
      75% {
        transform: translateX(5px);
      }
    }

    .map-part {
      display: grid;
      gap: 0.8rem;
      margin-top: 2.75rem;
    }

    .map-part h2,
    .map-part h3 {
      margin: 0;
      font-size: 1.2rem;
    }

    .map-part h3 {
      font-size: 1.05rem;
    }

    .map-lead {
      margin: 0;
      color: var(--kusabi-ink-dim);
      font-size: 0.88rem;
    }

    .map-lines {
      display: grid;
      gap: 0.55rem;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .map-lines li {
      padding-left: 0.8rem;
      border-left: 2px solid var(--kusabi-stone-3);
    }

    .map-short {
      margin-top: 0;
      padding: 1rem 1.1rem;
      border: 1px solid var(--kusabi-stone-line);
      background: rgba(22, 19, 17, 0.92);
    }

    .map-short .map-lines li {
      border-left-color: var(--kusabi-accent);
    }

    .arcs {
      display: grid;
      gap: 1.75rem;
    }

    .arc {
      display: grid;
      gap: 0.6rem;
    }

    .arc-head {
      display: flex;
      flex-wrap: wrap;
      gap: 0.3rem 0.8rem;
      align-items: baseline;
    }

    .arc-title {
      margin: 0;
      padding: 0.05rem 0.7rem;
      background: var(--kusabi-label);
      color: var(--kusabi-label-ink);
      font-family: var(--font-hand);
      font-size: 1.1rem;
      font-weight: 400;
      transform: rotate(-0.4deg);
    }

    .arc-chapters {
      color: var(--kusabi-ink-dim);
      font-size: 0.8rem;
    }

    .arc-what {
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.7;
    }

    .stops {
      display: grid;
      gap: 8px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .stop {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 10px;
      padding: 0.7rem 0.8rem;
      border: 1px solid var(--kusabi-stone-line);
      background: rgba(22, 19, 17, 0.92);
    }

    .stop-no {
      color: var(--kusabi-accent-bright);
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }

    .stop-place {
      margin: 0;
      font-weight: 700;
    }

    .stop-chapter {
      margin: 0;
      color: var(--kusabi-ink-dim);
      font-size: 0.76rem;
    }

    .stop-text {
      margin: 0.25rem 0 0;
      font-size: 0.93rem;
      line-height: 1.7;
    }

    .map-columns {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
      gap: 0 2rem;
    }

    .night,
    .knows,
    .ledger {
      display: grid;
      gap: 0.5rem;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 0.93rem;
    }

    .night li {
      display: grid;
      grid-template-columns: 8.5rem minmax(0, 1fr);
      gap: 10px;
      padding-bottom: 0.45rem;
      border-bottom: 1px solid var(--kusabi-stone-line);
    }

    .night small,
    .knows small,
    .ledger small {
      color: var(--kusabi-ink-dim);
      font-size: 0.78rem;
    }

    .clues {
      display: grid;
      gap: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .clue {
      display: grid;
      grid-template-columns: minmax(0, 10rem) minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.3rem 1rem;
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--kusabi-stone-line);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .clue p {
      margin: 0;
    }

    .clue-what {
      font-weight: 700;
    }

    .clue-first {
      color: var(--kusabi-ink-dim);
    }

    /* What only this page tells: set apart so nobody takes it for a recap. */
    .map-only {
      margin-top: 3.5rem;
      padding: 1.5rem 1.25rem 1.75rem;
      border: 1px solid rgba(232, 180, 94, 0.28);
      border-top: 2px solid var(--kusabi-lamp);
      background: rgba(28, 22, 16, 0.92);
    }

    .map-only-head {
      display: grid;
      gap: 0.4rem;
    }

    .map-only-head .kusabi-kicker {
      color: var(--kusabi-lamp);
    }

    .map-only-head h2 {
      margin: 0;
      font-size: 1.5rem;
    }

    .map-only .map-part:first-of-type {
      margin-top: 1.75rem;
    }

    .facts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
      gap: 1.1rem 2rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .fact {
      padding-left: 0.8rem;
      border-left: 2px solid rgba(232, 180, 94, 0.45);
    }

    .fact-title {
      margin: 0;
      color: var(--kusabi-lamp);
      font-size: 0.95rem;
      font-weight: 700;
    }

    .fact-text {
      margin: 0.2rem 0 0;
      font-size: 0.93rem;
      line-height: 1.7;
    }

    .answers {
      display: grid;
      gap: 0.3rem;
      margin: 0;
      font-size: 0.93rem;
      line-height: 1.7;
    }

    .answers dt {
      margin-top: 0.5rem;
      font-weight: 700;
    }

    .answers dd {
      margin: 0;
      color: var(--kusabi-ink-dim);
    }

    .knows li {
      padding-bottom: 0.45rem;
      border-bottom: 1px solid var(--kusabi-stone-line);
    }

    .knows strong {
      font-weight: 700;
    }

    .ledger li {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: 12px;
      align-items: start;
    }

    .ledger-label {
      padding: 0 0.5rem;
      background: var(--kusabi-label);
      color: var(--kusabi-label-ink);
      font-family: var(--font-hand);
      text-align: center;
    }

    @media (max-width: 640px) {
      .clue {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    @media (max-width: 560px) {
      .night li {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
      }

      .map-only {
        padding: 1.25rem 0.9rem 1.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .keypad[data-wrong="true"] .keypad-panel {
        animation: none;
      }
    }
  </style>
</KusabiBaseLayout>
