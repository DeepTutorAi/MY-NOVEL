---
// "Aa" control in the Sea top bar: prose size, line height and backdrop
// motion. Behaviour lives in src/scripts/sea/settings.ts.
const fontSteps = [
  { value: "s", label: "เล็ก", sample: "16" },
  { value: "m", label: "กลาง", sample: "18" },
  { value: "l", label: "ใหญ่", sample: "20" },
  { value: "xl", label: "ใหญ่มาก", sample: "23" },
];
const lineHeights = [
  { value: "normal", label: "ปกติ" },
  { value: "loose", label: "โปร่ง" },
];
---

<div class="sea-settings">
  <button
    type="button"
    class="sea-topbar-button sea-settings-toggle"
    data-sea-settings-toggle
    aria-expanded="false"
    aria-controls="sea-settings-panel"
  >
    <span lang="en">Aa</span><span class="sea-visually-hidden"> ตั้งค่าการอ่าน</span>
  </button>

  <div id="sea-settings-panel" class="sea-settings-panel" role="group" aria-label="ตั้งค่าการอ่าน" hidden>
    <fieldset class="sea-settings-group">
      <legend>ขนาดตัวอักษร</legend>
      <div class="sea-settings-options is-four">
        {fontSteps.map((step) => (
          <label class="sea-settings-option">
            <input type="radio" name="sea-font" value={step.value} />
            <span class="sea-settings-chip" data-step={step.value}>
              <span class="sea-settings-glyph" aria-hidden="true">ก</span>
              <span class="sea-settings-label">{step.label}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="sea-settings-group">
      <legend>ระยะบรรทัด</legend>
      <div class="sea-settings-options">
        {lineHeights.map((option) => (
          <label class="sea-settings-option">
            <input type="radio" name="sea-lh" value={option.value} />
            <span class="sea-settings-chip">
              <span class="sea-settings-label">{option.label}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <label class="sea-settings-switch">
      <input type="checkbox" role="switch" data-sea-motion-toggle />
      <span class="sea-settings-switch-track" aria-hidden="true"><span></span></span>
      <span class="sea-settings-switch-copy">
        <span>ฉากหลังเคลื่อนไหว</span>
        <small class="sea-settings-hint">อุปกรณ์นี้ตั้งค่าลดการเคลื่อนไหวไว้ ฉากหลังจะนิ่งเสมอ</small>
      </span>
    </label>
  </div>
</div>

<style>
  .sea-settings {
    position: relative;
  }

  .sea-settings-panel {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 2;
    display: grid;
    gap: 1.1rem;
    width: min(20rem, calc(100vw - 2rem));
    padding: 1.1rem 1.1rem 1.2rem;
    border: 1px solid color-mix(in srgb, var(--accent-cyan) 24%, transparent);
    border-bottom-color: color-mix(in srgb, var(--accent-copper) 45%, transparent);
    background: color-mix(in srgb, var(--bg-sea-night) 96%, black);
    box-shadow: 0 1.2rem 3rem rgba(0, 0, 0, 0.5);
    color: var(--sea-ink);
  }

  .sea-settings-panel[hidden] {
    display: none;
  }

  .sea-settings-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sea-settings-group legend {
    margin-bottom: 0.5rem;
    padding: 0;
    color: var(--sea-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .sea-settings-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .sea-settings-options.is-four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .sea-settings-option {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .sea-settings-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .sea-settings-chip {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.1rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.25rem;
    border: 1px solid var(--sea-line);
    color: var(--sea-ink-muted);
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: center;
    transition: border-color 150ms ease, color 150ms ease, background-color 150ms ease;
  }

  .sea-settings-glyph {
    font-family: var(--font-thai);
    line-height: 1.1;
  }

  .sea-settings-chip[data-step="s"] .sea-settings-glyph { font-size: 0.85rem; }
  .sea-settings-chip[data-step="m"] .sea-settings-glyph { font-size: 1rem; }
  .sea-settings-chip[data-step="l"] .sea-settings-glyph { font-size: 1.15rem; }
  .sea-settings-chip[data-step="xl"] .sea-settings-glyph { font-size: 1.35rem; }

  .sea-settings-option:hover .sea-settings-chip {
    border-color: color-mix(in srgb, var(--accent-cyan) 50%, transparent);
    color: var(--sea-ink);
  }

  .sea-settings-option input:checked + .sea-settings-chip {
    border-color: var(--accent-cyan);
    background: color-mix(in srgb, var(--accent-cyan) 10%, transparent);
    color: var(--sea-ink);
  }

  .sea-settings-option input:focus-visible + .sea-settings-chip {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 2px;
  }

  .sea-settings-switch {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.75rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--sea-line);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .sea-settings-switch input {
    position: absolute;
    width: 2.4rem;
    height: 1.4rem;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .sea-settings-switch-track {
    position: relative;
    display: block;
    width: 2.4rem;
    height: 1.4rem;
    border: 1px solid var(--sea-line);
    border-radius: 999px;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .sea-settings-switch-track span {
    position: absolute;
    top: 50%;
    left: 0.2rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 999px;
    background: var(--sea-ink-muted);
    transform: translateY(-50%);
    transition: transform 150ms ease, background-color 150ms ease;
  }

  .sea-settings-switch input:checked + .sea-settings-switch-track {
    border-color: var(--accent-cyan);
    background: color-mix(in srgb, var(--accent-cyan) 16%, transparent);
  }

  .sea-settings-switch input:checked + .sea-settings-switch-track span {
    background: var(--accent-cyan);
    transform: translate(1rem, -50%);
  }

  .sea-settings-switch input:focus-visible + .sea-settings-switch-track {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 3px;
  }

  .sea-settings-switch-copy {
    display: grid;
    gap: 0.2rem;
  }

  .sea-settings-hint {
    display: none;
    color: var(--sea-ink-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .sea-settings-hint {
      display: block;
    }

    .sea-settings-chip,
    .sea-settings-switch-track,
    .sea-settings-switch-track span {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .sea-settings {
      position: static;
    }

    .sea-settings-panel {
      position: fixed;
      top: var(--sea-topbar-height);
      right: 0;
      left: 0;
      width: auto;
      max-height: calc(100svh - var(--sea-topbar-height));
      overflow-y: auto;
      border-width: 0 0 1px;
    }
  }
</style>

<script>
  import { onSeaPage } from "../../../scripts/sea/lifecycle";
  import { bindReaderSettings } from "../../../scripts/sea/settings";

  onSeaPage("reader-settings", bindReaderSettings);
</script>
