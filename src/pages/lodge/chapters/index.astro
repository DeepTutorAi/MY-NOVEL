---
import { getCollection } from "astro:content";
import GuestCard from "../../../components/lodge/home/GuestCard.astro";
import LodgeBaseLayout from "../../../layouts/lodge/LodgeBaseLayout.astro";
import { ACTS } from "../../../data/lodge/acts";
import { withBase } from "../../../utils/base-path";
import { formatReadingTime } from "../../../utils/reading-time";
import "../../../styles/lodge/chapter.css";

const roman = ["I", "II", "III", "IV"];
const chapters = (await getCollection("chapters")).sort(
  (a, b) => a.data.number - b.data.number,
);
const intro = chapters.filter((c) => c.data.number === 0);
---

<LodgeBaseLayout
  title="สารบัญ — ฮวิตเวลต์ ลอดจ์"
  description="สารบัญฮวิตเวลต์ ลอดจ์ แบ่งตามช่วง"
  bodyClass="toc-page"
>
  <main class="toc ledger" data-ledger>
    <header class="ledger-cover">
      <p class="ledger-folder" aria-hidden="true">GUEST RECORDS</p>
      <h1>ฮวิตเวลต์ ลอดจ์</h1>
      <p class="toc-intro">เลือกอ่านตามบท บทอ่านจะเปิดในหน้าที่จัดสำหรับการอ่านยาวโดยเฉพาะ</p>
    </header>

    {
      intro.map((c) => (
        <section class="toc-act">
          <ul class="toc-list">
            <li>
              <a class="toc-row" data-ledger-row data-chapter-number={c.data.number} data-chapter-id={c.id} href={withBase(`/lodge/chapters/${c.id}/`)}>
                <span class="toc-row-number">บทนำ</span>
                <span class="toc-row-copy">
                  <span class="toc-row-title">{c.data.title}</span>
                  {c.data.thaiTitle && <span class="toc-row-thai"> — {c.data.thaiTitle}</span>}
                  {c.data.summary && <span class="toc-row-summary">{c.data.summary}</span>}
                </span>
                <span class="toc-row-time">{formatReadingTime(c.data.readingMinutes)}</span>
                <span class="ledger-status" data-ledger-status>ยังไม่เปิด</span>
              </a>
            </li>
          </ul>
        </section>
      ))
    }

    {
      ACTS.map((act, index) => {
        const actChapters = chapters.filter((chapter) => chapter.data.act === act.number && chapter.data.number !== 0);

        return (
          <section class="toc-act" aria-labelledby={`act-${act.number}`}>
            <h2 id={`act-${act.number}`}>
              ช่วง {roman[index]} · {act.title}
            </h2>
            <ul class="toc-list">
              {actChapters.map((chapter) => (
                <li>
                  <a class="toc-row" data-ledger-row data-chapter-number={chapter.data.number} data-chapter-id={chapter.id} href={withBase(`/lodge/chapters/${chapter.id}/`)}>
                    <span class="toc-row-number">บทที่ {chapter.data.number}</span>
                    <span class="toc-row-copy">
                      <span class="toc-row-title">{chapter.data.title}</span>
                      {chapter.data.thaiTitle && <span class="toc-row-thai"> — {chapter.data.thaiTitle}</span>}
                      {chapter.data.summary && <span class="toc-row-summary">{chapter.data.summary}</span>}
                    </span>
                    <span class="toc-row-time">{formatReadingTime(chapter.data.readingMinutes)}</span>
                    <span class="ledger-status" data-ledger-status>ยังไม่เปิด</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }

    <section class="ledger-guest" aria-labelledby="ledger-guest-title">
      <h2 id="ledger-guest-title">ผู้มาเยือนคนล่าสุด</h2>
      <GuestCard />
    </section>
  </main>

  <script>
    import { setupLedger } from "../../../scripts/lodge/toc/ledger";

    const updateReads = () => {
      try {
        const raw = localStorage.getItem("hvitveldt:secret:reads");
        const reads = raw ? JSON.parse(raw) : [];
        if (Array.isArray(reads)) {
          const links = document.querySelectorAll(".toc-row[data-chapter-id]");
          links.forEach((link) => {
            if (link instanceof HTMLElement) {
              const id = link.dataset.chapterId;
              if (id && reads.includes(id)) {
                link.classList.add("is-read");
              }
            }
          });
        }
      } catch (e) {}
    };

    const updateLedger = () => {
      const root = document.querySelector<HTMLElement>("[data-ledger]");
      if (root) setupLedger(root);
    };

    updateReads();
    updateLedger();
    document.addEventListener("astro:page-load", () => {
      updateReads();
      updateLedger();
    });
  </script>

  <style>
    .toc-row.is-read::after {
      content: " 📌";
      margin-left: 0.5rem;
      font-size: 0.9em;
      filter: drop-shadow(0 0 2px var(--accent));
    }

    /* GUEST RECORDS (design 5.3): a ledger folder in graphite. */
    .ledger {
      background: var(--paper-grain);
    }

    .ledger-cover {
      margin-block-end: 2.5rem;
      padding-block-end: 1.5rem;
      border-block-end: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
    }

    .ledger-folder {
      display: inline-block;
      margin: 0 0 1rem;
      padding: 0.35rem 0.8rem;
      border: 1px solid var(--graphite-2);
      color: var(--graphite-1);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      letter-spacing: 0.24em;
    }

    .ledger .toc-row {
      position: relative;
      grid-template-columns: minmax(4.5rem, auto) 1fr auto 6.5rem;
      border-block-end: 1px dashed color-mix(in oklab, var(--ink) 14%, transparent);
    }

    @media (max-width: 640px) {
      .ledger .toc-row {
        grid-template-columns: 1fr auto;
      }

      .ledger .toc-row > :not(.ledger-status) {
        grid-column: 1 / -1;
      }

      .ledger-status {
        grid-column: 2;
      }
    }

    .ledger .toc-row-number {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--graphite-2);
    }

    .ledger-status {
      align-self: center;
      justify-self: end;
      color: var(--graphite-2);
      font-family: var(--font-mono);
      font-size: 0.75rem;
      white-space: nowrap;
    }

    .ledger-status.is-stamp {
      padding: 0.1rem 0.45rem;
      border: 2px solid var(--stamp-red);
      color: var(--stamp-red);
      font-weight: 700;
      letter-spacing: 0.16em;
      transform: rotate(-6deg);
      opacity: 0.85;
    }

    .ledger-guest {
      margin-block-start: 3.5rem;
    }

    .ledger-guest h2 {
      margin: 0 0 1rem;
      color: var(--ink-dim);
      font-family: var(--font-display);
      font-size: 1.3rem;
      font-weight: 400;
    }
  </style>
</LodgeBaseLayout>
