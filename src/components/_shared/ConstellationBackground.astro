---
// "Lightfall" hub background: ribbons of light falling through a net of stars, drawn on one canvas.
---
<div class="lightfall-scene" data-lightfall-scene aria-hidden="true">
  <canvas id="lightfall-canvas"></canvas>
</div>

<style>
  .lightfall-scene {
    position: fixed;
    inset: 0;
    z-index: 1; /* Sits behind text and cards (z-index 2) but above the page background */
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(180deg, #02030a 0%, #0d1020 50%, #322e37 82%, #0e0b11 86%, #030307 100%);
  }

  /* Touch browsers resize the viewport as the URL bar shows and hides; the largest viewport
     keeps the scene from being rebuilt on every scroll. */
  @media (pointer: coarse) {
    .lightfall-scene {
      inset: 0 0 auto 0;
      height: 100vh;
      height: 100lvh;
    }
  }

  .lightfall-scene canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import type { SceneHandle } from "../../scripts/_shared/scene-runtime";

  type LightfallWindow = Window & {
    __bindDynamicCityBg?: () => void;
    __dynamicCityBgCleanup?: () => void;
    __dynamicCityBgInitialized?: boolean;
  };

  const win = window as LightfallWindow;
  let live: { canvas: HTMLCanvasElement; handle: SceneHandle } | null = null;
  let pending: HTMLCanvasElement | null = null;

  const cleanup = () => {
    pending = null;
    live?.handle.destroy();
    live = null;
    win.__dynamicCityBgInitialized = false;
  };

  const bind = () => {
    const wrapper = document.getElementById("constellation-bg-container");
    const scene = wrapper?.querySelector<HTMLElement>("[data-lightfall-scene]");
    const canvas = scene?.querySelector<HTMLCanvasElement>("canvas");
    if (!wrapper || wrapper.style.display === "none" || !scene || !canvas) {
      cleanup();
      return;
    }
    if ((live && live.canvas === canvas) || pending === canvas) return;
    cleanup();
    pending = canvas;
    // The scene's code loads only when this theme is the one showing.
    void import("../../scripts/hub/lightfall-scene").then(({ createLightfallScene }) => {
      if (pending !== canvas) return;
      pending = null;
      const handle = createLightfallScene(canvas, scene, {
        avoid: ".hub-title-group, .hub-side-note, .hub-profile-widget, .hub-footer",
        avoidTextOnly: ".hub-title-group",
        avoidSoft: ".novel-card, .resume-card",
        pointerBlock: ".hub-title-group, .hub-side-note, .hub-profile-widget, .hub-footer, .novel-card, .resume-card, .hub-modal-overlay",
      });
      live = { canvas, handle };
      handle.start();
      win.__dynamicCityBgInitialized = true;
    });
  };

  win.__bindDynamicCityBg = bind;
  win.__dynamicCityBgCleanup = cleanup;
  bind();
</script>
