---
// The optional guest book on the home page (design section 5.2). Never a gate:
// the start link above it always works. Behaviour in src/scripts/lodge/home/guest-book.ts.
// The name field has no maxlength on purpose: it counts UTF-16 code units and
// would cut an emoji or Thai cluster; normalizeGuestName keeps 40 whole clusters.
import GuestCard from "./GuestCard.astro";
---

<section class="guest-book" data-guest-book aria-labelledby="guest-book-title">
  <h2 id="guest-book-title" class="guest-book-title">สมุดลงชื่อแขก</h2>
  <p class="guest-book-lead">ลงชื่อไว้ก็ได้ ไม่ลงก็ได้ ชื่อจะเก็บอยู่ในเครื่องนี้เท่านั้น</p>
  <GuestCard />
  <form class="guest-book-form" data-guest-form>
    <label for="guest-name">ชื่อ</label>
    <input id="guest-name" name="guest-name" type="text" autocomplete="off" spellcheck="false" />
    <div class="guest-book-buttons">
      <button type="submit" data-guest-sign>เซ็นชื่อ</button>
      <button type="button" data-guest-skip>ข้าม</button>
    </div>
  </form>
  <div class="guest-book-buttons" data-guest-actions hidden>
    <button type="button" data-guest-edit>แก้ชื่อ</button>
    <button type="button" data-guest-erase>ลบลายเซ็น</button>
  </div>
  <p class="guest-book-notice" data-guest-notice role="status" hidden></p>
</section>

<script>
  import { onPage } from "../../../scripts/_shared/lifecycle";
  import { setupGuestBook } from "../../../scripts/lodge/home/guest-book";
  import { lodgeDrift, readFinished } from "../../../scripts/lodge/progress-core";

  onPage("lodge-guest-book", { bodyClass: "lodge-home" }, () => {
    const book = document.querySelector<HTMLElement>("[data-guest-book]");
    if (!book) return;
    let level = lodgeDrift(new Set());
    try {
      level = lodgeDrift(readFinished(window.localStorage));
    } catch {
      // Unreadable storage: the card is shown as for a new reader.
    }
    return setupGuestBook(book, level);
  });
</script>

<style>
  .guest-book {
    display: grid;
    gap: 1rem;
    margin-block: 4rem 0;
  }

  .guest-book-title {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .guest-book-lead {
    margin: 0;
    color: var(--ink-dim);
    font-size: 0.95rem;
  }

  .guest-book-form {
    display: grid;
    gap: 0.5rem;
  }

  .guest-book-form[hidden],
  .guest-book-buttons[hidden],
  .guest-book-notice[hidden] {
    display: none;
  }

  .guest-book-form label {
    color: var(--ink-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .guest-book-form input {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--ink) 22%, transparent);
    background: rgb(14 13 12 / 0.7);
    color: var(--ink);
    font-family: var(--font-hand);
    font-size: 1.15rem;
  }

  .guest-book-form input:focus-visible {
    outline: 2px solid var(--graphite-1);
    outline-offset: 2px;
  }

  .guest-book-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .guest-book-buttons button {
    min-height: 44px;
    min-width: 44px;
    padding: 0.5rem 1.1rem;
    border: 1px solid color-mix(in oklab, var(--ink) 26%, transparent);
    background: transparent;
    color: var(--ink);
    font-family: var(--font-thai);
    font-size: 0.95rem;
    cursor: pointer;
  }

  .guest-book-buttons button:hover,
  .guest-book-buttons button:focus-visible {
    border-color: var(--graphite-1);
    outline: none;
  }

  .guest-book-notice {
    margin: 0;
    color: var(--stamp-red);
    font-size: 0.9rem;
  }
</style>
