---
// Start panel for a reader with no reading record (spec 2.17). Shown purely by CSS
// while the resume card is hidden; the pick button is enabled by chrome.
---

<section class="hub-start" data-hub-start aria-labelledby="hub-start-title">
  <div class="hub-start-copy">
    <span class="hub-start-kicker">เริ่มต้นที่นี่</span>
    <h2 id="hub-start-title">ยังไม่ได้เริ่มอ่านเรื่องไหนเลย</h2>
    <p>ให้ช่วยเลือกเรื่องแรกให้ก็ได้ หรือเลื่อนลงไปดูทุกเรื่องบนชั้นหนังสือ</p>
  </div>
  <div class="hub-start-actions">
    <button type="button" class="hub-pick-btn" data-hub-pick="start" disabled>ช่วยเลือกให้หน่อย</button>
  </div>
</section>
