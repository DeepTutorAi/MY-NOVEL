---
import type { NovelMeta } from "../../data/_novels";
import { withBase } from "../../utils/base-path";

interface Props {
  novel: NovelMeta;
}

const { novel } = Astro.props;
const isAvailable = novel.status === "เผยแพร่";
const heroImage = withBase(novel.heroImage);
const accentStyle = `--novel-accent: ${novel.accent}`;
const useImage = novel.heroState !== "placeholder";
// The short link name replaces the card text, so subtitle and status/length
// are attached as its description.
const descriptionId = `novel-card-${novel.slug}-desc`;
---

<div class="novel-card-wrapper" data-novel-slug={novel.slug} data-status={novel.status}>
  {
    isAvailable ? (
      <>
        <a
          class="novel-card"
          style={accentStyle}
          href={withBase(novel.href)}
          aria-label={`เปิดอ่าน ${novel.titleTh}`}
          aria-describedby={`${descriptionId}-subtitle ${descriptionId}-meta ${descriptionId}-state`}
          data-active-card
        >
          {/* Shares its transition name with the hero of the novel's home page, so
              opening a card morphs its art into that page. */}
          <span class="novel-card-media" aria-hidden="true" transition:name={`novel-hero-${novel.slug}`}>
            {
              useImage ? (
                <img src={heroImage} alt="" loading="eager" decoding="async" />
              ) : (
                <span class="novel-card-placeholder">
                  <span class="station-line" />
                  <span class="station-moon" />
                  <span class="station-platform" />
                </span>
              )
            }
            <span class="novel-card-progress" data-card-progress hidden>
              <span />
            </span>
          </span>
          <span class="novel-card-body">
            <span class="novel-card-kicker">{novel.titleEn}</span>
            <strong class="novel-card-title">{novel.titleTh}</strong>
            <span class="novel-card-subtitle" id={`${descriptionId}-subtitle`}>{novel.subtitle}</span>
            <span class="novel-card-meta" id={`${descriptionId}-meta`}>{novel.mood} · {novel.length}</span>
            <span class="novel-card-footer">
              <span class="novel-card-state" id={`${descriptionId}-state`} data-card-state data-default={novel.badge ?? ""}>
                {novel.badge ?? ""}
              </span>
              <span class="novel-card-action">เข้าสู่เรื่อง</span>
            </span>
          </span>
        </a>
        <a class="novel-card-continue" style={accentStyle} href={withBase(novel.href)} data-card-continue hidden>อ่านต่อ</a>
      </>
    ) : (
      /* A closed novel: only what a passer-by should know. The English title stays off the
         page, because it is also the password on the gate this card leads to. */
      <a
        class="novel-card is-disabled"
        style={accentStyle}
        href={withBase(novel.href)}
        aria-label={`${novel.titleTh} ยังไม่เปิดให้อ่าน ${novel.status}`}
        data-astro-reload
      >
        <span class="novel-card-media" aria-hidden="true">
          {useImage && <img src={heroImage} alt="" loading="eager" decoding="async" />}
        </span>
        <span class="novel-card-body">
          <strong class="novel-card-title">{novel.titleTh}</strong>
          <span class="novel-card-subtitle">{novel.subtitle}</span>
          <span class="novel-card-meta">{novel.mood}</span>
          <span class="novel-card-footer">
            <span>{novel.status}</span>
            <span class="novel-card-action">ยังไม่เปิดให้อ่าน</span>
          </span>
        </span>
      </a>
    )
  }
</div>
