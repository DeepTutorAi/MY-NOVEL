---
// Mothlight hub background: luna moths in a moonlit garden, rendered on one canvas.
---
<div class="mothlight-scene" data-mothlight-scene aria-hidden="true">
  <canvas id="mothlight-sky"></canvas>
</div>

<style>
  .mothlight-scene {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(180deg, #07081a 0%, #0b0c25 45%, #141236 100%);
  }

  /* Touch browsers resize the viewport as the URL bar shows and hides; the largest viewport
     keeps the scene from being rebuilt on every scroll. */
  @media (pointer: coarse) {
    .mothlight-scene {
      inset: 0 0 auto 0;
      height: 100vh;
      height: 100lvh;
    }
  }

  .mothlight-scene canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { createMothlightScene } from "../../scripts/hub/mothlight-scene";
  import type { SceneHandle } from "../../scripts/hub/scene-runtime";

  type MothlightWindow = Window & {
    __bindMothlightBg?: () => void;
    __mothlightBgCleanup?: () => void;
    __mothlightBgInitialized?: boolean;
  };

  const win = window as MothlightWindow;
  let live: { canvas: HTMLCanvasElement; handle: SceneHandle } | null = null;

  const cleanup = () => {
    live?.handle.destroy();
    live = null;
    win.__mothlightBgInitialized = false;
  };

  const bind = () => {
    const wrapper = document.getElementById("mothlight-bg-container");
    const scene = wrapper?.querySelector<HTMLElement>("[data-mothlight-scene]");
    const canvas = scene?.querySelector<HTMLCanvasElement>("canvas");
    if (!wrapper || wrapper.style.display === "none" || !scene || !canvas) {
      cleanup();
      return;
    }
    if (live && live.canvas === canvas) return;
    cleanup();
    const handle = createMothlightScene(canvas, scene, {
      avoid: ".hub-title-group, .hub-side-note, .hub-profile-widget, .hub-footer",
      avoidSoft: ".novel-card, .resume-card",
      pointerBlock: ".hub-title-group, .hub-side-note, .hub-profile-widget, .hub-footer, .novel-card, .resume-card, .hub-modal-overlay",
    });
    live = { canvas, handle };
    handle.start();
    win.__mothlightBgInitialized = true;
  };

  win.__bindMothlightBg = bind;
  win.__mothlightBgCleanup = cleanup;
  bind();
</script>
