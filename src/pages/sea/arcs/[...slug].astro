---
// Legacy URL from the arc-based Sea layout. The only page ever published there
// was the prologue, which now lives at /sea/chapters/00/.
import { withBase } from "../../../utils/base-path";

export function getStaticPaths() {
  return [{ params: { slug: "arc-01/01-introduction" } }];
}

const target = withBase("/sea/chapters/00/");
const canonical = new URL(target, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ย้ายไปที่บทนำ — ทะเลเหนือโลก</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </head>
  <body>
    <p>หน้านี้ย้ายแล้ว <a href={target}>ไปที่บทนำของทะเลเหนือโลก</a></p>
  </body>
</html>
