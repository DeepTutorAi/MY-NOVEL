---
import PlatformCard from "../../components/tsukinomi/platform/PlatformCard.astro";
import { FIRST_PERSON } from "../../data/tsukinomi/characters";
import TsukinomiBaseLayout from "../../layouts/tsukinomi/TsukinomiBaseLayout.astro";
import { STOP_CHAPTERS, stopNumber } from "../../scripts/tsukinomi/station-gates";
import "../../styles/tsukinomi/platform.css";
---

<TsukinomiBaseLayout
  title="ตัวละคร — สถานีทะเลพระจันทร์"
  description="ผู้คนในสถานีทะเลพระจันทร์ เปิดเพิ่มทีละป้ายตามบทที่อ่านจบ"
  bodyClass="tsukinomi-characters-page section-home palette-autumn"
  sectionPalette="autumn"
  backgroundSlotId="hero-station"
>
  <main id="tsukinomi-main" class="pf" data-platform data-era="then">
    {/* The sky (moonsea-loader.ts): empty, aria-hidden, fixed behind everything, never takes a pointer. */}
    <div class="tsuki-moonsea" aria-hidden="true" data-moonsea-mount></div>
    <div class="pf-winter" aria-hidden="true"></div>

    <header class="pf-head">
      <p class="pf-kicker">Route Map · <span lang="ja">路線図</span></p>
      <h1>ผู้คนที่สถานีทะเลพระจันทร์</h1>
      <p class="pf-lead">ป้ายรายทางจะมีชื่อเมื่ออ่านถึง และแต่ละคนจะมีเรื่องเพิ่มตามบทที่อ่านจบ</p>
      <p class="pf-stats" data-route-stats></p>
      <div class="pf-era" role="group" aria-label="ช่วงเวลา" data-era-switch hidden>
        <button type="button" data-era-to="then" aria-pressed="true">ปี 2008</button>
        <button type="button" data-era-to="later" aria-pressed="false">ปี 2018</button>
      </div>
      <p class="pf-error" role="status" data-platform-error hidden>โหลดข้อมูลบางส่วนไม่ได้ ลองเปิดหน้านี้อีกครั้ง</p>
    </header>

    <section class="pf-route" aria-label="ตัวละครตามป้ายรายทาง" data-route>
      <PlatformCard person={FIRST_PERSON} number={stopNumber(0)} />
      {
        STOP_CHAPTERS.map((chapter, index) => (
          <p class="pf-stop" data-stop>
            <span class="pf-number" data-stop-number>{stopNumber(index + 1)}</span>
            <span class="pf-stop-name">ป้ายนี้ยังไม่มีชื่อ</span>
            <span class="pf-stop-when">เปิดเมื่ออ่านจบบทที่ {chapter}</span>
          </p>
        ))
      }
    </section>

    <template data-card-template><PlatformCard /></template>
  </main>

  <script>
    import { onPage } from "../../scripts/_shared/lifecycle";
    import { setupPlatform } from "../../scripts/tsukinomi/platform";

    onPage("tsukinomi-platform", { bodyClass: "tsukinomi-characters-page" }, () => setupPlatform());
  </script>
</TsukinomiBaseLayout>
