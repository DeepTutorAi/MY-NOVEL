---
// FireflyBackground.astro: lamphu trees and synchronised fireflies over a canal
// at night. Rendering lives in src/scripts/hub/firefly-scene.ts.
---
<div class="firefly-scene" data-firefly-scene aria-hidden="true">
  <canvas class="ff-static" data-layer="sky"></canvas>
  <canvas class="ff-static" data-layer="far"></canvas>
  <canvas class="ff-river" data-layer="river"></canvas>
  <canvas class="ff-static" data-layer="near"></canvas>
  <canvas id="fireflies-canvas" class="ff-fx" data-layer="fx"></canvas>
  <canvas class="ff-reeds" data-layer="reeds"></canvas>
  <div class="ff-vignette"></div>
</div>

<style>
  .firefly-scene {
    --ff-margin: 28px;
    position: fixed;
    inset: 0 0 auto;
    /* Large viewport height: mobile URL-bar changes do not resize (and repaint) the scene. */
    height: 100vh;
    height: 100lvh;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    background: #050a16;
  }

  .firefly-scene canvas {
    position: absolute;
    display: block;
    /* Overscanned layers are wider than the viewport; override the preflight cap. */
    max-width: none;
  }

  .ff-static {
    top: calc(var(--ff-margin) * -1);
    left: calc(var(--ff-margin) * -1);
    width: calc(100% + var(--ff-margin) * 2);
    height: calc(100% + var(--ff-margin) * 2);
    will-change: transform;
  }

  .ff-river {
    left: calc(var(--ff-margin) * -1);
    width: calc(100% + var(--ff-margin) * 2);
    will-change: transform;
  }

  .ff-fx {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ff-reeds {
    bottom: 0;
    left: calc(var(--ff-margin) * -1);
    width: calc(100% + var(--ff-margin) * 2);
    will-change: transform;
  }

  .ff-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 120% 90% at 50% 40%, transparent 55%, rgba(1, 3, 8, 0.55) 100%),
      linear-gradient(to bottom, rgba(2, 4, 12, 0.35), transparent 18%);
  }
</style>

<script>
  import { mountFireflyScene, type FireflySceneHandle } from "../../scripts/hub/firefly-scene";

  // Bind contract with the hub theme switcher (src/pages/index.astro).
  type FireflyWindow = Window & {
    __bindFireflyBg?: () => void;
    __fireflyBgCleanup?: () => void;
    __fireflyBgInitialized?: boolean;
  };
  const win = window as FireflyWindow;
  let live: { root: HTMLElement; handle: FireflySceneHandle } | null = null;

  const cleanup = () => {
    live?.handle.destroy();
    live = null;
    win.__fireflyBgInitialized = false;
  };

  const bind = () => {
    const container = document.getElementById("firefly-bg-container");
    const root = container?.querySelector<HTMLElement>("[data-firefly-scene]");
    if (!container || !root || container.style.display === "none") {
      cleanup();
      return;
    }
    // Already running on this exact DOM: nothing to do.
    if (live && live.root === root) return;
    cleanup();
    const handle = mountFireflyScene(root, { quietSelector: ".hub-hero h1, .hub-hero p" });
    if (!handle) return;
    live = { root, handle };
    win.__fireflyBgInitialized = true;
  };

  win.__bindFireflyBg = bind;
  win.__fireflyBgCleanup = cleanup;
  bind();
</script>
