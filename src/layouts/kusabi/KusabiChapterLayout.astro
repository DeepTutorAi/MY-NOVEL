---
import KusabiBaseLayout from "./KusabiBaseLayout.astro";
import KusabiCutscene from "../../components/kusabi/cutscene/KusabiCutscene.astro";
import ReaderChrome from "../../components/kusabi/reading/ReaderChrome.astro";

interface Props {
  title: string;
  description: string;
  /** The content entry id, also the storage key of this reader's progress. */
  unitId: string;
  unitKind: "chapter" | "extra";
  number: number;
  unitTitle: string;
  act?: number;
  musicCueId: string;
  epigraph?: string;
  /** Unlock that must hold before the text is shown (Extra chapters). */
  gate?: string;
}

const { title, description, unitId, unitKind, number, unitTitle, act = 3, musicCueId, epigraph, gate } = Astro.props;
---

<KusabiBaseLayout title={title} description={description} bodyClass={`kusabi-reading act-${act}`}>
  {epigraph && <KusabiCutscene chapter={number} epigraph={epigraph} label={unitTitle} />}
  <ReaderChrome />

  <main class="reader">
    <slot name="gate" />
    <article
      class="chapter"
      data-unit-id={unitId}
      data-unit-kind={unitKind}
      data-unit-title={unitTitle}
      data-chapter={String(number)}
      data-act={act}
      data-audio-cue={musicCueId}
      data-gate={gate}
      data-gated={gate ? "" : undefined}
      hidden={gate ? true : undefined}
    >
      <slot />
    </article>
  </main>

  <script>
    import { onPage } from "../../scripts/_shared/lifecycle";
    import { setupKusabiCutscene } from "../../scripts/kusabi/cutscene";
    import { setupReader } from "../../scripts/kusabi/reading/reader";

    onPage("kusabi-reader", { bodyClass: "kusabi-reading" }, () => setupReader());
    onPage("kusabi-cutscene", { bodyClass: "kusabi-reading" }, () => setupKusabiCutscene());
  </script>

  <style is:global>
    .reader {
      position: relative;
      z-index: 6;
      width: min(800px, calc(100% - 32px));
      min-height: 100vh;
      margin: 0 auto;
      padding: calc(var(--kusabi-topbar-height) + 3.5rem) 0 6rem;
    }

    /* Illustrations: a plain figure the reader can open full size. */
    figure.kusabi-figure {
      width: 100%;
      max-width: 34rem;
      margin: 3rem auto;
    }

    .kusabi-figure-zoom {
      display: block;
      width: 100%;
      padding: 0;
      border: 1px solid var(--kusabi-stone-line);
      background: none;
      cursor: zoom-in;
    }

    .kusabi-figure-zoom img {
      display: block;
      width: 100%;
      height: auto;
    }
  </style>
</KusabiBaseLayout>
