---
import { getCollection } from "astro:content";
import TapeShelf from "../../components/kusabi/home/TapeShelf.astro";
import KusabiBaseLayout from "../../layouts/kusabi/KusabiBaseLayout.astro";
import { withBase } from "../../utils/base-path";

const chapters = (await getCollection("kusabiChapters")).sort((a, b) => a.data.number - b.data.number);
const first = chapters[0];
const startHref = first ? withBase(`/kusabi/chapters/${first.id}/`) : withBase("/kusabi/#kusabi-shelf");
const plate = withBase("/assets/kusabi/images/cover/plate.webp");
const hours = Math.round(chapters.reduce((sum, chapter) => sum + (chapter.data.readingMinutes ?? 0), 0) / 60);
---

<KusabiBaseLayout
  title="บ้านคุซาบิบนเขาคุโระมิโซะ"
  description="ทริปพักร้อนของเพื่อนห้าคน ข่าวลือเรื่องเจ้าสาวภูเขา และบ้านหินบนเขาที่ตกลงกันว่าจะแวะดูแค่ยี่สิบนาที"
  bodyClass="kusabi-home"
>
  <link slot="head" rel="preload" as="image" href={plate} type="image/webp" />
  <div class="kusabi-manor" aria-hidden="true" data-manor-mount data-plate-url={plate}></div>

  <main class="home">
    <section class="hero" aria-labelledby="home-title">
      <picture class="hero-art" aria-hidden="true" transition:name="novel-hero-kusabi">
        <img src={plate} alt="" loading="eager" decoding="async" width="1024" height="1536" />
      </picture>
      <div class="hero-copy">
        <p class="kusabi-kicker">Kusabi House</p>
        <h1 id="home-title"><span>บ้านคุซาบิ</span> <span>บนเขาคุโระมิโซะ</span></h1>
        <p class="hero-line">
          ทริปพักร้อนของเพื่อนห้าคน ข่าวลือเรื่องเจ้าสาวภูเขา และบ้านหินบนเขาที่ตกลงกันว่าจะแวะดูแค่ยี่สิบนาที
        </p>
        <p class="hero-meta">12 บท · บทนำและบทส่งท้าย · ประมาณ {hours} ชั่วโมง</p>
        <div class="hero-actions">
          <a class="kusabi-strip" href={startHref} data-start>เริ่มฟังม้วนแรก</a>
          <a class="kusabi-ghost" href="#kusabi-shelf">ดูชั้นเทป</a>
        </div>
        <div class="resume" data-resume hidden>
          <span class="resume-label">อ่านค้างไว้</span>
          <strong data-resume-title></strong>
          <div class="resume-actions">
            <a class="kusabi-strip" data-resume-link href={startHref}>อ่านต่อ</a>
            <button type="button" class="resume-clear" data-resume-clear>ล้างตำแหน่ง</button>
          </div>
        </div>
      </div>
    </section>

    <TapeShelf />

    <nav class="more" aria-label="ส่วนอื่นของเรื่อง">
      <a href={withBase("/kusabi/characters/")}>ตัวละคร</a>
      <a href={withBase("/kusabi/extra/")}>ส่วนเสริมและแกลเลอรี</a>
      <a href={withBase("/kusabi/case-map/")}>แผนผัง</a>
    </nav>
  </main>

  <script>
    import { onPage } from "../../scripts/_shared/lifecycle";
    import { startManor } from "../../scripts/kusabi/home/manor-loader";
    import { setupShelf } from "../../scripts/kusabi/home/shelf";

    onPage("kusabi-manor", { bodyClass: "kusabi-home" }, () =>
      startManor(document.querySelector<HTMLElement>("[data-manor-mount]")),
    );
    onPage("kusabi-shelf", { bodyClass: "kusabi-home" }, () => setupShelf());
  </script>

  <style is:global>
    .kusabi-manor {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }

    .kusabi-manor-canvas {
      display: block;
      width: 100%;
      height: 100%;
      animation: kusabi-manor-in 700ms ease-out both;
    }

    @keyframes kusabi-manor-in {
      from {
        opacity: 0;
      }
    }

    /* The scene brings its own rain and dark. */
    body.kusabi-manor-live .kusabi-rain-canvas,
    body.kusabi-manor-live .kusabi-abyssal-mist {
      display: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .kusabi-manor-canvas {
        animation: none;
      }
    }
  </style>

  <style>
    .home {
      position: relative;
      z-index: 2;
    }

    .hero {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 100vh;
      min-height: 100svh;
      overflow: hidden;
      padding: calc(var(--kusabi-topbar-height) + 1.5rem) clamp(20px, 6vw, 88px) 2.5rem;
    }

    /* Same box as placePlate() so the scene fades in over the picture without a jump. */
    .hero-art {
      position: absolute;
      top: calc(46svh - 61svh * 0.9922);
      right: 0;
      height: 122svh;
      max-width: 68vw;
      aspect-ratio: 2 / 3;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 34%), linear-gradient(180deg, #000 58%, transparent 96%);
      mask-image: linear-gradient(90deg, transparent, #000 34%), linear-gradient(180deg, #000 58%, transparent 96%);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }

    .hero-art img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    :global(body.kusabi-manor-live) .hero-art {
      visibility: hidden;
    }

    .hero-copy {
      position: relative;
      display: grid;
      gap: 0.85rem;
      justify-items: start;
      width: min(34rem, 46vw);
    }

    .hero-copy::before {
      content: "";
      position: absolute;
      inset: -3rem -4rem -3rem -8rem;
      z-index: -1;
      background: radial-gradient(ellipse at 40% 50%, rgba(11, 9, 8, 0.72), transparent 72%);
      pointer-events: none;
    }

    .hero-copy h1 {
      margin: 0;
      font-size: clamp(2rem, 4.4vw, 3.4rem);
      font-weight: 700;
      line-height: 1.22;
      text-shadow: 0 2px 18px rgba(0, 0, 0, 0.85);
    }

    .hero-copy h1 span {
      display: inline-block;
    }

    .hero-line {
      margin: 0;
      color: var(--kusabi-ink);
      font-size: clamp(1rem, 1.4vw, 1.15rem);
      text-shadow: 0 1px 10px rgba(0, 0, 0, 0.95);
    }

    .hero-meta {
      margin: 0;
      color: var(--kusabi-ink-dim);
      font-family: var(--font-mono);
      font-size: 0.76rem;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      align-items: center;
      margin-top: 0.4rem;
    }

    .resume {
      display: grid;
      gap: 0.35rem;
      width: 100%;
      margin-top: 0.4rem;
      padding: 0.85rem 1rem;
      border-left: 2px solid var(--kusabi-lamp);
      background: rgba(11, 9, 8, 0.78);
    }

    .resume-label {
      color: var(--kusabi-lamp);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
    }

    .resume strong {
      font-weight: 400;
    }

    .resume-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      align-items: center;
      margin-top: 0.3rem;
    }

    .resume-clear {
      min-height: 44px;
      padding: 0 0.3rem;
      border: 0;
      background: none;
      color: var(--kusabi-ink-dim);
      font-family: var(--font-thai);
      font-size: 0.85rem;
      cursor: pointer;
    }

    .resume-clear:hover {
      color: var(--kusabi-ink);
    }

    .more {
      position: relative;
      z-index: 5;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
      justify-content: center;
      padding: 1rem 16px 5rem;
    }

    .more a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--kusabi-ink-dim);
      font-size: 0.92rem;
      text-decoration: underline;
      text-decoration-color: var(--kusabi-stone-3);
      text-underline-offset: 0.3em;
    }

    .more a:hover {
      color: var(--kusabi-ink);
    }

    @media (max-aspect-ratio: 105 / 100) {
      .hero {
        align-items: flex-end;
        padding-bottom: 3rem;
      }

      .hero-art {
        top: 0;
        left: -6vw;
        right: auto;
        width: 112vw;
        height: auto;
        max-width: none;
        -webkit-mask-image: linear-gradient(180deg, #000 58%, transparent 96%);
        mask-image: linear-gradient(180deg, #000 58%, transparent 96%);
      }

      .hero-copy {
        width: 100%;
      }

      .hero-copy::before {
        inset: -5rem -2rem -3rem;
        background: linear-gradient(180deg, transparent, rgba(11, 9, 8, 0.86) 28%);
      }
    }

    /* A landscape phone keeps the copy beside the plate and lets it scroll. */
    @media (orientation: landscape) and (max-height: 500px) {
      .hero {
        align-items: flex-start;
        padding-bottom: 1.25rem;
      }

      .hero-copy {
        gap: 0.45rem;
        width: 56vw;
      }

      .hero-copy h1 {
        font-size: clamp(1.5rem, 9svh, 2.1rem);
      }

      .hero-line {
        font-size: 0.92rem;
      }
    }
  </style>
</KusabiBaseLayout>
