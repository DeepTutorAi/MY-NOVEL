<div
  id="sea-sonar-panel"
  class="sea-sonar-player"
  data-open="false"
  data-playing="false"
  tabindex="-1"
  role="dialog"
  aria-label="แผงควบคุมเสียงบรรยากาศ"
  inert
>
  <div class="sonar-player-head">
    <span lang="en">Current Rail & Sonar</span>
    <strong data-sonar-cue></strong>
  </div>

  <div class="sonar-player-controls">
    <button
      class="sonar-icon-button sonar-play"
      type="button"
      data-sonar-play
      aria-pressed="false"
      aria-label="เสียงบรรยากาศ"
      title="เล่นเสียง"
    >
      <svg class="sonar-play-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 3l14 9-14 9V3z" />
      </svg>
      <svg class="sonar-pause-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
      </svg>
    </button>
    <p class="sonar-status" data-sonar-status></p>
  </div>

  <label class="sonar-field">
    <span>ระดับเสียงรวม</span>
    <input data-sonar-volume type="range" min="0" max="1" step="0.04" />
  </label>

  <div class="sonar-soundscapes" role="group" aria-label="เสียงแวดล้อม">
    <div class="sonar-soundscape" data-soundscape="rain-drip">
      <label class="sonar-switch">
        <input data-soundscape-toggle="rain-drip" type="checkbox" />
        <span>ฝนตกเคาะท่อทองแดง</span>
      </label>
      <input
        data-soundscape-volume="rain-drip"
        aria-label="ระดับเสียงฝนตก"
        type="range"
        min="0"
        max="0.8"
        step="0.04"
      />
    </div>

    <div class="sonar-soundscape" data-soundscape="pressure-hum">
      <label class="sonar-switch">
        <input data-soundscape-toggle="pressure-hum" type="checkbox" />
        <span>ความหนาแน่นอากาศความถี่ต่ำ</span>
      </label>
      <input
        data-soundscape-volume="pressure-hum"
        aria-label="ระดับเสียงความหนาแน่นอากาศ"
        type="range"
        min="0"
        max="0.8"
        step="0.04"
      />
    </div>
  </div>
</div>
<!-- The panel is inert while closed, so its status line cannot announce.
     This region stays outside it and is the only live one. -->
<p class="sea-visually-hidden" role="status" aria-live="polite" data-sonar-live></p>

<style>
  .sea-sonar-player {
    position: fixed;
    right: 1.5rem;
    bottom: 6.2rem;
    z-index: 21;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    width: 280px;
    padding: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent-cyan) 22%, transparent);
    border-bottom-color: color-mix(in srgb, var(--accent-copper) 40%, transparent);
    background: color-mix(in srgb, var(--bg-sea-night) 96%, black);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.5);
    color: var(--sea-ink);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 200ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 200ms;
  }

  .sea-sonar-player[data-open="true"] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .sonar-player-head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sea-line);
    color: var(--sea-ink-muted);
    font-family: var(--font-thai);
    font-size: 0.75rem;
  }

  .sonar-player-head strong {
    color: var(--accent-cyan);
    font-size: 0.85rem;
    font-weight: normal;
  }

  .sonar-player-controls {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .sonar-status {
    min-height: 1.5em;
    margin: 0;
    color: var(--sea-ink-muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .sonar-icon-button {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--accent-copper);
    border-radius: 999px;
    color: var(--sea-ink);
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }

  .sonar-icon-button:hover,
  .sonar-icon-button[aria-pressed="true"] {
    border-color: var(--accent-cyan);
    background: color-mix(in srgb, var(--accent-copper) 20%, transparent);
  }

  .sonar-icon-button svg {
    width: 20px;
    height: 20px;
  }

  .sea-sonar-player[data-playing="true"] .sonar-play-icon,
  .sea-sonar-player[data-playing="false"] .sonar-pause-icon {
    display: none;
  }

  .sonar-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--sea-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .sonar-field input[type="range"],
  .sonar-soundscape input[type="range"] {
    height: 1.25rem;
    margin: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .sonar-field input[type="range"]::-webkit-slider-runnable-track,
  .sonar-soundscape input[type="range"]::-webkit-slider-runnable-track {
    height: 3px;
    border-radius: 999px;
    background: var(--sea-line);
  }

  .sonar-field input[type="range"]::-moz-range-track,
  .sonar-soundscape input[type="range"]::-moz-range-track {
    height: 3px;
    border-radius: 999px;
    background: var(--sea-line);
  }

  .sonar-field input[type="range"]::-webkit-slider-thumb,
  .sonar-soundscape input[type="range"]::-webkit-slider-thumb {
    width: 12px;
    height: 12px;
    margin-top: -4.5px;
    border-radius: 999px;
    background: var(--accent-cyan);
    box-shadow: 0 0 4px var(--accent-cyan);
    appearance: none;
    -webkit-appearance: none;
  }

  .sonar-field input[type="range"]::-moz-range-thumb,
  .sonar-soundscape input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 999px;
    background: var(--accent-cyan);
    box-shadow: 0 0 4px var(--accent-cyan);
  }

  .sonar-field input[type="range"]:focus-visible,
  .sonar-soundscape input[type="range"]:focus-visible {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 3px;
  }

  .sonar-soundscapes {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--sea-line);
  }

  .sonar-soundscape {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sonar-switch {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--sea-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .sonar-switch input[type="checkbox"] {
    display: inline-grid;
    place-items: center;
    width: 14px;
    height: 14px;
    margin: 0;
    border: 1px solid var(--sea-ink-muted);
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }

  .sonar-switch input[type="checkbox"]:checked {
    border-color: var(--accent-cyan);
    background: var(--accent-cyan);
  }

  .sonar-switch input[type="checkbox"]:checked::after {
    width: 6px;
    height: 6px;
    content: "";
    background: var(--bg-sea-night);
  }

  .sonar-switch input[type="checkbox"]:focus-visible {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sea-sonar-player,
    .sea-sonar-player[data-open="true"] {
      transform: none;
      transition: none;
    }
  }

  :global(html[data-sea-motion="off"]) .sea-sonar-player {
    transform: none;
    transition: none;
  }

  /* Below 1024px the panel opens from the top bar's Sonar button and hangs
     under the bar; at phone width it docks full-width. */
  @media (max-width: 1023px) {
    .sea-sonar-player {
      top: var(--sea-topbar-height);
      right: 0.75rem;
      bottom: auto;
      z-index: 31;
      max-height: calc(100svh - var(--sea-topbar-height) - 1rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      transform: translateY(-8px);
    }
  }

  @media (max-width: 760px) {
    .sea-sonar-player {
      right: 0;
      left: 0;
      width: auto;
      max-height: calc(100svh - var(--sea-topbar-height));
      padding: 1.1rem max(1rem, env(safe-area-inset-right)) 1.25rem max(1rem, env(safe-area-inset-left));
      border-width: 0 0 1px;
    }
  }
</style>

<script>
  import { getSeaMusicCue, SEA_SOUNDSCAPES } from "../../../data/sea/music-cues";
  import { onSeaPage } from "../../../scripts/sea/lifecycle";
  import { seaAudio, type SeaAudioStatus } from "../../../scripts/sea/sea-audio-state";

  // Sliders run on raw gain values (0-1, 0-0.8); screen readers get a percentage of the slider's range.
  const describeSlider = (slider: HTMLInputElement) => {
    const max = Number(slider.max) || 1;
    slider.setAttribute("aria-valuetext", `${Math.round((Number(slider.value) / max) * 100)} เปอร์เซ็นต์`);
  };

  const setSliderValue = (slider: HTMLInputElement, value: number) => {
    slider.value = String(value);
    describeSlider(slider);
  };

  const STATUS_TEXT: Record<SeaAudioStatus, string> = {
    playing: "กำลังเล่น",
    blocked: "แตะที่ใดก็ได้เพื่อเริ่มเสียง",
    suspended: "พักเสียงชั่วคราว",
    off: "ปิดเสียง",
  };

  onSeaPage("sonar", () => {
    const panel = document.getElementById("sea-sonar-panel");
    const triggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-sonar-corner], [data-sonar-topbar]"),
    );
    if (!panel || triggers.length === 0) return;

    seaAudio.init();

    const playBtn = panel.querySelector<HTMLButtonElement>("[data-sonar-play]");
    const volSlider = panel.querySelector<HTMLInputElement>("[data-sonar-volume]");
    const cueLabel = panel.querySelector<HTMLElement>("[data-sonar-cue]");
    const statusLine = panel.querySelector<HTMLElement>("[data-sonar-status]");
    const liveStatus = document.querySelector<HTMLElement>("[data-sonar-live]");
    let openedBy: HTMLButtonElement | null = null;

    const isOpen = () => panel.dataset.open === "true";

    const setOpen = (open: boolean, trigger: HTMLButtonElement | null = null, returnFocus = false) => {
      panel.dataset.open = String(open);
      panel.toggleAttribute("inert", !open);
      for (const button of triggers) button.setAttribute("aria-expanded", String(open));
      if (open) {
        openedBy = trigger;
        panel.focus({ preventScroll: true });
        return;
      }
      const previous = openedBy;
      openedBy = null;
      if (returnFocus) previous?.focus({ preventScroll: true });
    };

    const onTriggerClick = (event: MouseEvent) => {
      const trigger = event.currentTarget instanceof HTMLButtonElement ? event.currentTarget : null;
      if (isOpen()) {
        setOpen(false);
      } else {
        setOpen(true, trigger);
      }
    };

    const syncState = () => {
      const playing = seaAudio.isPlaying();
      panel.dataset.playing = String(playing);
      for (const button of triggers) button.dataset.playing = String(playing);
      if (playBtn) {
        playBtn.setAttribute("aria-pressed", String(playing));
        playBtn.title = playing ? "หยุดเสียง" : "เล่นเสียง";
      }
      if (cueLabel) cueLabel.textContent = getSeaMusicCue(seaAudio.getCurrentCue()).labelTh;
      if (volSlider) setSliderValue(volSlider, seaAudio.getVolume());
      for (const { id } of SEA_SOUNDSCAPES) {
        const toggle = panel.querySelector<HTMLInputElement>(`[data-soundscape-toggle="${id}"]`);
        const slider = panel.querySelector<HTMLInputElement>(`[data-soundscape-volume="${id}"]`);
        if (toggle) toggle.checked = seaAudio.getSoundscapeEnabled(id);
        if (slider) setSliderValue(slider, seaAudio.getSoundscapeVolume(id));
      }
    };

    const onStatus = (event: Event) => {
      const status = (event as CustomEvent<SeaAudioStatus>).detail;
      if (!(status in STATUS_TEXT)) return;
      if (statusLine) statusLine.textContent = STATUS_TEXT[status];
      if (liveStatus) liveStatus.textContent = STATUS_TEXT[status];
    };

    const onPlay = () => seaAudio.userToggle();
    const onVolume = () => {
      if (!volSlider) return;
      seaAudio.setVolume(Number(volSlider.value));
      describeSlider(volSlider);
    };

    const onSoundscapeInput = (event: Event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      const toggleId = target.dataset.soundscapeToggle;
      const volumeId = target.dataset.soundscapeVolume;
      const known = (id: string | undefined) => SEA_SOUNDSCAPES.find((cue) => cue.id === id)?.id;
      const toggleCue = known(toggleId);
      const volumeCue = known(volumeId);
      if (toggleCue && event.type === "change") seaAudio.setSoundscapeEnabled(toggleCue, target.checked);
      if (volumeCue && event.type === "input") {
        seaAudio.setSoundscapeVolume(volumeCue, Number(target.value));
        describeSlider(target);
      }
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape" && isOpen()) {
        event.preventDefault();
        setOpen(false, null, true);
      }
    };

    const onDocumentPointer = (event: PointerEvent) => {
      if (!isOpen()) return;
      const target = event.target;
      if (!(target instanceof Node) || panel.contains(target)) return;
      if (triggers.some((button) => button.contains(target))) return;
      setOpen(false);
    };

    const onFocusOut = (event: FocusEvent) => {
      const next = event.relatedTarget;
      if (!isOpen() || !(next instanceof Node) || panel.contains(next)) return;
      if (triggers.some((button) => button.contains(next))) return;
      setOpen(false);
    };

    const unsubscribe = seaAudio.subscribe(syncState);
    syncState();
    // Only the visible line is filled on bind; the live region changes on
    // status events alone, so a page swap does not re-announce the status.
    if (statusLine) statusLine.textContent = STATUS_TEXT[seaAudio.getStatus()];

    for (const button of triggers) {
      button.addEventListener("click", onTriggerClick);
      button.addEventListener("keydown", onKeydown);
    }
    playBtn?.addEventListener("click", onPlay);
    volSlider?.addEventListener("input", onVolume);
    panel.addEventListener("change", onSoundscapeInput);
    panel.addEventListener("input", onSoundscapeInput);
    panel.addEventListener("keydown", onKeydown);
    panel.addEventListener("focusout", onFocusOut);
    document.addEventListener("pointerdown", onDocumentPointer);
    window.addEventListener("sea:audio:status", onStatus);

    return () => {
      unsubscribe();
      for (const button of triggers) {
        button.removeEventListener("click", onTriggerClick);
        button.removeEventListener("keydown", onKeydown);
      }
      playBtn?.removeEventListener("click", onPlay);
      volSlider?.removeEventListener("input", onVolume);
      panel.removeEventListener("change", onSoundscapeInput);
      panel.removeEventListener("input", onSoundscapeInput);
      panel.removeEventListener("keydown", onKeydown);
      panel.removeEventListener("focusout", onFocusOut);
      document.removeEventListener("pointerdown", onDocumentPointer);
      window.removeEventListener("sea:audio:status", onStatus);
    };
  });
</script>
