---
import { PUBLIC_CARDS } from "../../data/kusabi/characters";
import KusabiBaseLayout from "../../layouts/kusabi/KusabiBaseLayout.astro";
import { withBase } from "../../utils/base-path";

// Locked files show nothing but an empty frame. Their text and pictures are not
// in this HTML and are fetched only after their unlock (scripts/kusabi/characters.ts).
const LOCKED_FRAMES = 3;
---

<KusabiBaseLayout
  title="ตัวละคร · บ้านคุซาบิบนเขาคุโระมิโซะ"
  description="รู้จักคนที่ขึ้นเขาคุโระมิโซะก่อนอ่าน หน้านี้เปิดเพิ่มตามบทที่อ่านจบ และไม่เฉลยก่อนเวลา"
  bodyClass="kusabi-characters"
>
  <main class="kusabi-page book" data-book="guest">
    <header class="kusabi-page-head">
      <p class="kusabi-kicker" data-book-kicker>Guest Book</p>
      <h1 data-book-title>สมุดรายชื่อแขก</h1>
      <p data-book-lead>รู้จักก่อนอ่านได้เลย หน้านี้จะเพิ่มเองตามบทที่อ่านจบ และไม่เฉลยล่วงหน้า</p>
    </header>

    <p class="book-error" data-book-error role="status" hidden>บางแฟ้มโหลดไม่ได้ ลองเปิดหน้านี้อีกครั้ง</p>

    <section class="entries" aria-label="แฟ้มตัวละคร" data-entries>
      {
        PUBLIC_CARDS.map((card) => (
          <article class="entry" data-card={card.id}>
            <div class="entry-photo">
              {card.image && (
                <img src={withBase(`/assets/kusabi/images/${card.image}`)} alt={`ภาพตัวละคร ${card.name}`} loading="lazy" decoding="async" width="480" height="600" />
              )}
            </div>
            <div class="entry-copy">
              <h2 class="entry-name">{card.name}</h2>
              <p class="entry-role">{card.role}</p>
              <p class="entry-note">{card.note}</p>
              <ul class="entry-notes" data-card-notes />
            </div>
          </article>
        ))
      }
      {
        Array.from({ length: LOCKED_FRAMES }, () => (
          <article class="entry is-locked" data-locked-frame aria-hidden="true">
            <div class="entry-photo" />
            <div class="entry-copy">
              <p class="entry-blank" />
              <p class="entry-blank is-short" />
            </div>
          </article>
        ))
      }
    </section>

    <p class="book-hint" data-book-hint>กรอบว่างจะมีชื่อเมื่ออ่านถึง</p>

    <section class="last-row" data-last-row hidden aria-label="แถวสุดท้ายของสมุด">
      <p class="last-row-mark">แถวสุดท้ายยังไม่มีชื่อ</p>
      <p class="last-row-text" data-last-row-text></p>
    </section>
  </main>

  <script>
    import { onPage } from "../../scripts/_shared/lifecycle";
    import { setupCharacters } from "../../scripts/kusabi/characters";

    onPage("kusabi-book", { bodyClass: "kusabi-characters" }, () => setupCharacters());
  </script>

  <style is:global>
    .entries {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 430px), 1fr));
      gap: 14px;
    }

    .entry {
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      gap: 16px;
      padding: 12px;
      border: 1px solid var(--kusabi-stone-line);
      background: linear-gradient(180deg, rgba(36, 32, 29, 0.94), rgba(22, 19, 17, 0.96));
    }

    .entry-photo {
      aspect-ratio: 4 / 5;
      overflow: hidden;
      background: #100e0d;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.6);
    }

    .entry-photo img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .entry-photo-blank {
      display: grid;
      place-items: center;
      height: 100%;
      color: var(--kusabi-ink-dim);
      font-size: 0.76rem;
    }

    .entry-copy {
      display: grid;
      align-content: start;
      gap: 0.35rem;
      min-width: 0;
    }

    .entry-name {
      justify-self: start;
      margin: 0;
      padding: 0.05rem 0.7rem;
      background: var(--kusabi-label);
      color: var(--kusabi-label-ink);
      font-family: var(--font-hand);
      font-size: 1.18rem;
      font-weight: 400;
      line-height: 1.5;
      transform: rotate(-0.5deg);
    }

    .entry-role {
      margin: 0.15rem 0 0;
      color: var(--kusabi-lamp);
      font-size: 0.8rem;
    }

    .entry-note {
      margin: 0;
      color: var(--kusabi-ink);
      font-size: 0.92rem;
      line-height: 1.65;
    }

    .entry-notes {
      display: grid;
      gap: 0.2rem;
      margin: 0.3rem 0 0;
      padding: 0;
      list-style: none;
    }

    .entry-notes:empty {
      display: none;
    }

    .entry-notes li {
      padding-left: 0.65rem;
      border-left: 1px solid var(--kusabi-stone-3);
      color: var(--kusabi-ink-dim);
      font-size: 0.86rem;
    }

    .entry-notes li.is-pen {
      color: #c9c1cf;
      font-family: var(--font-hand);
      font-size: 1rem;
    }

    .entry-notes li.is-struck {
      height: 1.2rem;
      background: linear-gradient(transparent 44%, var(--kusabi-stone-3) 44% 58%, transparent 58%);
      background-size: 62% 100%;
      background-repeat: no-repeat;
      background-position: 0.65rem 0;
    }

    .entry.is-locked {
      opacity: 0.5;
    }

    .entry-blank {
      height: 1.5rem;
      margin: 0;
      border-bottom: 1px solid var(--kusabi-stone-line);
    }

    .entry-blank.is-short {
      width: 60%;
    }

    .entry.is-new {
      animation: entry-new 800ms ease-out both;
    }

    .entry.is-merging {
      animation: entry-merge 900ms ease-in 900ms both;
    }

    @keyframes entry-new {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }

    @keyframes entry-merge {
      to {
        opacity: 0;
        transform: scale(0.97);
      }
    }

    .book[data-book="behaviour"] .entry {
      border-color: rgba(229, 57, 53, 0.2);
    }

    .book-hint {
      margin: 1.5rem 0 0;
      color: var(--kusabi-ink-dim);
      font-size: 0.84rem;
    }

    .book-error {
      margin: 0 0 1rem;
      color: var(--kusabi-accent-bright);
      font-size: 0.9rem;
    }

    .last-row {
      display: grid;
      gap: 0.2rem;
      margin-top: 2.25rem;
      padding: 0.8rem 1rem;
      border-left: 2px solid var(--kusabi-accent);
      background: rgba(22, 19, 17, 0.9);
    }

    .last-row-mark {
      margin: 0;
      color: var(--kusabi-ink-dim);
      font-family: var(--font-mono);
      font-size: 0.74rem;
    }

    .last-row-text {
      margin: 0;
      font-family: var(--font-hand);
      font-size: 1.1rem;
    }

    @media (max-width: 480px) {
      .entry {
        grid-template-columns: 96px minmax(0, 1fr);
        gap: 12px;
        padding: 10px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .entry.is-new,
      .entry.is-merging {
        animation: none;
      }
    }
  </style>
</KusabiBaseLayout>
