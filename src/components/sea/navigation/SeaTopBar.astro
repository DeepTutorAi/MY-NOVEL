---
// Sea top bar. On chapter pages it carries the chapter context, the chapter
// drawer trigger and the reader settings; on the home page "สารบัญ" jumps to
// the table of contents. The Sonar button only shows below 1024px, where the
// floating sonar corner is hidden because it would cover the prose column.
// Not transition:persist: the context label and controls differ per page, so
// a persisted bar would show stale content.
import ReaderSettings from "../reading/ReaderSettings.astro";
import { withBase } from "../../../utils/base-path";

interface Props {
  mode: "home" | "chapter";
  context?: string;
}

const { mode, context } = Astro.props;
const isChapter = mode === "chapter";
---

<header class="sea-topbar" data-sea-topbar transition:animate="none">
  <a href={withBase("/sea/")} class="sea-topbar-mark" lang="en">THE SEA</a>
  {context && <p class="sea-topbar-context" title={context}>{context}</p>}
  <nav class="sea-topbar-nav" aria-label="เครื่องมือของทะเลเหนือโลก">
    {isChapter ? (
      <button
        type="button"
        class="sea-topbar-button"
        data-sea-drawer-open
        aria-haspopup="dialog"
        aria-controls="sea-chapter-drawer"
      >
        สารบัญ
      </button>
    ) : (
      <a href="#sea-toc" class="sea-topbar-button">สารบัญ</a>
    )}
    {isChapter && <ReaderSettings />}
    <button
      type="button"
      class="sea-topbar-button sea-topbar-sonar"
      data-sonar-topbar
      data-playing="false"
      aria-controls="sea-sonar-panel"
      aria-expanded="false"
      aria-label="เปิดแผงเสียงโซนาร์"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
        <circle cx="12" cy="12" r="9" stroke-dasharray="2 2" />
        <circle cx="12" cy="12" r="5" />
        <circle cx="12" cy="12" r="1.4" fill="currentColor" />
      </svg>
    </button>
    <a href={withBase("/")} class="sea-topbar-button sea-topbar-hub" lang="en" data-astro-reload>HUB</a>
  </nav>
</header>

<style>
  .sea-topbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: var(--sea-topbar-height);
    padding: 0 max(1rem, env(safe-area-inset-right)) 0 max(1rem, env(safe-area-inset-left));
    border-bottom: 1px solid color-mix(in srgb, var(--accent-cyan) 14%, transparent);
    background: color-mix(in srgb, var(--bg-sea-night) 82%, transparent);
    color: var(--sea-ink-muted);
    backdrop-filter: blur(14px);
    transition:
      transform 260ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 200ms ease,
      background-color 0.8s ease;
  }

  /* Copper rim light from the world below, under the cool hairline. */
  .sea-topbar::after {
    position: absolute;
    right: 18%;
    bottom: -1px;
    left: 18%;
    height: 1px;
    content: "";
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent-copper) 45%, transparent), transparent);
    pointer-events: none;
  }

  .sea-topbar.is-hidden {
    transform: translateY(calc(-100% - 2px));
  }

  .sea-topbar:focus-within {
    transform: none;
    opacity: 1;
  }

  :global(html[data-sea-motion="off"]) .sea-topbar.is-hidden:not(:focus-within) {
    transform: none;
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sea-topbar {
      transition: opacity 200ms ease;
    }

    .sea-topbar.is-hidden:not(:focus-within) {
      transform: none;
      opacity: 0;
      pointer-events: none;
    }
  }

  .sea-topbar a {
    text-decoration: none;
  }

  .sea-topbar-mark {
    flex-shrink: 0;
    color: var(--sea-ink);
    font-family: var(--font-display-sea);
    font-size: 1.05rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .sea-topbar-context {
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--sea-ink-muted);
    font-size: 0.82rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .sea-topbar-nav {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .sea-topbar :global(.sea-topbar-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.7rem;
    border: 1px solid transparent;
    border-radius: 2px;
    color: var(--sea-ink-muted);
    font-family: var(--font-thai);
    font-size: 0.82rem;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }

  .sea-topbar :global(.sea-topbar-button:hover),
  .sea-topbar :global(.sea-topbar-button[aria-expanded="true"]) {
    border-color: color-mix(in srgb, var(--accent-cyan) 35%, transparent);
    color: var(--sea-ink);
  }

  .sea-topbar :global(.sea-topbar-button:focus-visible) {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 2px;
  }

  .sea-topbar .sea-topbar-hub {
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .sea-topbar .sea-topbar-sonar {
    display: none;
  }

  .sea-topbar-sonar svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .sea-topbar .sea-topbar-sonar[data-playing="true"] {
    color: var(--accent-cyan);
  }

  /* Below the rail breakpoint the bar stays over scrolling prose on devices
     where a live blur is costly, so it drops the blur for a denser fill. */
  @media (max-width: 1023px) {
    .sea-topbar {
      background: color-mix(in srgb, var(--bg-sea-night) 95%, transparent);
      backdrop-filter: none;
    }

    .sea-topbar .sea-topbar-sonar {
      display: inline-flex;
    }
  }

  @media (max-width: 760px) {
    .sea-topbar {
      gap: 0.5rem;
      background: var(--bg-sea-night);
    }

    .sea-topbar :global(.sea-topbar-button) {
      padding: 0 0.55rem;
    }
  }

  @media (max-width: 480px) {
    .sea-topbar-context {
      display: none;
    }
  }
</style>

<script>
  import { onSeaPage } from "../../../scripts/sea/lifecycle";
  import { bindTopBar } from "../../../scripts/sea/reader/topbar";

  onSeaPage("topbar", bindTopBar);
</script>
