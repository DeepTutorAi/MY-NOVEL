---
import { getCollection } from "astro:content";
import { EXTRA_UNITS } from "../../../data/kusabi/units";
import { MOMENT_GROUPS } from "../../../data/kusabi/unlocks";
import KusabiBaseLayout from "../../../layouts/kusabi/KusabiBaseLayout.astro";
import { withBase } from "../../../utils/base-path";

const chapters = (await getCollection("kusabiChapters")).sort((a, b) => a.data.number - b.data.number);
// How many pictures each chapter holds: enough to draw empty frames, nothing more.
const artFrames = chapters.flatMap((chapter) => {
  const count = (chapter.body?.match(/!\[/g) ?? []).length;
  return Array.from({ length: count }, (_, index) => ({ chapter: chapter.data.number, index }));
});
const extraBase = withBase("/kusabi/extra/");
---

<KusabiBaseLayout
  title="ส่วนเสริม · บ้านคุซาบิบนเขาคุโระมิโซะ"
  description="เรื่องเสริมและแกลเลอรีของบ้านคุซาบิ เปิดตามบทที่อ่านจบ"
  bodyClass="kusabi-extra-room"
>
  <main class="kusabi-page room" data-extra-base={extraBase}>
    <header class="kusabi-page-head">
      <p class="kusabi-kicker">Lower Drawer</p>
      <h1>ลิ้นชักล่าง</h1>
      <p>สิ่งที่อยู่ในนี้เปิดตามที่อ่านจบ ป้ายที่ยังว่างจะเขียนขึ้นเอง</p>
    </header>

    <section class="room-section" aria-labelledby="extra-heading">
      <h2 id="extra-heading">เรื่องเสริม</h2>
      <div class="room-gate" data-extra-gate>
        <p>เรื่องเสริมมีเรื่องที่ต้องรู้จากบทส่งท้ายก่อน ตอนแรกจะเปิดเมื่ออ่านบทส่งท้ายจบ และอ่านบทหลักแล้วอย่างน้อย 10 จาก 12 บท</p>
        <div class="room-meter" aria-hidden="true"><span data-extra-meter></span></div>
        <p class="room-count" data-extra-count>อ่านบทหลักแล้ว 0 จาก 12 บท</p>
      </div>
      <ol class="extra-tapes" data-extra-list>
        {
          EXTRA_UNITS.map((unit) => (
            <li class="extra-tape" data-extra={unit.id} data-number={unit.number}>
              <span class="extra-mark" aria-hidden="true">{unit.number}</span>
              <span class="extra-paper"><span data-extra-title /></span>
              <span class="extra-state" data-extra-state>ยังไม่มีป้าย</span>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="kusabi-gallery" class="room-section" aria-labelledby="gallery-heading" data-gallery>
      <h2 id="gallery-heading">แกลเลอรี</h2>
      <p class="room-lead">ภาพประกอบของแต่ละบทจะเข้ามาอยู่ที่นี่เมื่ออ่านบทนั้นจบ</p>
      <div class="frames" data-art-frames>
        {
          artFrames.map((frame) => (
            <button type="button" class="frame" data-frame={`t${frame.chapter}`} data-frame-index={frame.index} disabled aria-label="ภาพที่ยังไม่เปิด">
              <span class="frame-label">{frame.chapter === 0 ? "นำ" : frame.chapter === 13 ? "ท้าย" : frame.chapter}</span>
            </button>
          ))
        }
      </div>
      <h3>ภาพที่ไม่ได้อยู่ในเล่ม</h3>
      <p class="room-lead">เปิดเมื่ออ่านบทส่งท้ายและเรื่องเสริมจบ</p>
      <div class="frames-moments">
        {
          MOMENT_GROUPS.flatMap((group) =>
            group.ratios.map((ratio) => (
              <button type="button" class="frame frame-moment" data-moment={group.file} style={`--ratio: ${ratio}`} disabled aria-label="ภาพที่ยังไม่เปิด">
                <span class="frame-label">{group.label}</span>
              </button>
            )),
          )
        }
      </div>
    </section>

    <section class="room-section" aria-labelledby="behind-heading" data-behind hidden>
      <h2 id="behind-heading">แฟ้มเบื้องหลัง</h2>
      <div class="behind-table" data-behind-people></div>
      <h3>ม้วนเทปประกอบฉาก</h3>
      <ul class="behind-tapes" data-behind-tapes></ul>
    </section>

    <details class="dev-key">
      <summary>ทางลัดผู้พัฒนา</summary>
      <div class="dev-key-row">
        <label for="bypass-password">รหัส</label>
        <input id="bypass-password" type="password" autocomplete="off" data-bypass-input />
        <button type="button" class="kusabi-ghost" data-bypass-btn>ปลดล็อก</button>
      </div>
      <p class="dev-key-error" data-bypass-error role="status" hidden>รหัสไม่ถูกต้อง</p>
    </details>
  </main>

  <dialog class="lightbox" data-lightbox aria-label="ภาพขยาย">
    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" />
    <p class="lightbox-caption" data-lightbox-caption hidden></p>
    <button type="button" class="kusabi-ghost lightbox-close" data-lightbox-close>ปิด</button>
  </dialog>

  <script>
    import { onPage } from "../../../scripts/_shared/lifecycle";
    import { setupExtraRoom } from "../../../scripts/kusabi/extra-room";

    onPage("kusabi-room", { bodyClass: "kusabi-extra-room" }, () => setupExtraRoom());
  </script>

  <style is:global>
    .room-section {
      display: grid;
      gap: 1rem;
      margin-bottom: 3.5rem;
      scroll-margin-top: calc(var(--kusabi-topbar-height) + 1rem);
    }

    .room-section h2 {
      margin: 0;
      font-size: 1.35rem;
    }

    .room-section h3 {
      margin: 1rem 0 0;
      color: var(--kusabi-ink-dim);
      font-size: 0.95rem;
      font-weight: 400;
    }

    .room-lead {
      margin: 0;
      color: var(--kusabi-ink-dim);
      font-size: 0.92rem;
    }

    .room-gate {
      display: grid;
      gap: 0.55rem;
      max-width: 38rem;
      padding: 0.9rem 1rem;
      border-left: 2px solid var(--kusabi-stone-3);
      background: rgba(22, 19, 17, 0.9);
      font-size: 0.92rem;
    }

    .room-gate p {
      margin: 0;
    }

    .room-meter {
      height: 4px;
      background: rgba(255, 255, 255, 0.07);
    }

    .room-meter span {
      display: block;
      width: 0;
      height: 100%;
      background: var(--kusabi-lamp);
    }

    .room-count {
      color: var(--kusabi-ink-dim);
      font-family: var(--font-mono);
      font-size: 0.74rem;
    }

    .extra-tapes {
      display: grid;
      gap: 7px;
      margin: 0;
      padding: 10px;
      border: 1px solid var(--kusabi-stone-line);
      background: linear-gradient(180deg, rgba(36, 32, 29, 0.92), rgba(20, 17, 15, 0.94));
      list-style: none;
    }

    .extra-tape {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 10px;
      align-items: center;
      min-height: 52px;
      padding: 6px 12px 6px 8px;
      border: 1px solid rgba(0, 0, 0, 0.55);
      background: linear-gradient(180deg, #2b2724, #1b1816);
    }

    .extra-mark {
      color: var(--kusabi-ink-dim);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      text-align: center;
    }

    .extra-paper {
      display: block;
      min-height: 1.75rem;
      padding: 2px 10px;
      background: var(--kusabi-label);
      color: var(--kusabi-label-ink);
      font-family: var(--font-hand);
      font-size: 1.02rem;
      line-height: 1.5;
    }

    .extra-tape:not([data-open="true"]) .extra-paper {
      opacity: 0.45;
    }

    .extra-paper a {
      color: inherit;
      text-decoration: none;
    }

    .extra-paper a:hover {
      text-decoration: underline;
    }

    .extra-state {
      color: var(--kusabi-ink-dim);
      font-size: 0.74rem;
      white-space: nowrap;
    }

    .extra-summary {
      grid-column: 2 / -1;
      margin: 0;
      color: var(--kusabi-ink-dim);
      font-size: 0.86rem;
    }

    .frames {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(112px, 1fr));
      gap: 8px;
    }

    .frame {
      position: relative;
      display: block;
      aspect-ratio: 2 / 3;
      width: 100%;
      padding: 0;
      overflow: hidden;
      border: 1px solid var(--kusabi-stone-line);
      background: repeating-linear-gradient(135deg, #171412 0 6px, #1b1815 6px 12px);
      color: var(--kusabi-ink-dim);
      cursor: default;
    }

    .frame:not(:disabled) {
      cursor: zoom-in;
    }

    .frame img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .frame-label {
      position: absolute;
      top: 6px;
      left: 7px;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-shadow: 0 1px 3px #000;
    }

    /* Each row shares one height, so no picture loses its edges to a crop. */
    .frames-moments {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .frame-moment {
      flex-grow: calc(var(--ratio) * 100);
      flex-basis: calc(var(--ratio) * 240px);
      width: auto;
      max-width: min(100%, calc(var(--ratio) * 420px));
      aspect-ratio: var(--ratio);
    }

    .lightbox-caption {
      margin: 0;
      padding: 0.6rem 1rem max(0.8rem, env(safe-area-inset-bottom));
      color: var(--kusabi-ink);
      font-family: var(--font-hand);
      font-size: 1.05rem;
      text-align: center;
    }

    .lightbox:has(.lightbox-caption:not([hidden])) {
      align-content: center;
    }

    .lightbox:has(.lightbox-caption:not([hidden])) img {
      max-height: calc(100dvh - 4.5rem);
    }

    /* After CH11 the chapter pictures read as if seen on the old screens. The moments were never on one. */
    [data-gallery][data-crt="true"] .frame:not(:disabled):not(.frame-moment)::after {
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(180deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px);
      content: "";
      pointer-events: none;
    }

    .behind-table {
      display: grid;
      gap: 6px;
    }

    .behind-row {
      display: grid;
      grid-template-columns: minmax(9rem, 12rem) 3.5rem minmax(0, 1fr);
      gap: 10px;
      padding: 0.45rem 0.6rem;
      border-bottom: 1px solid var(--kusabi-stone-line);
      font-size: 0.9rem;
    }

    .behind-row span:nth-child(2) {
      color: var(--kusabi-ink-dim);
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }

    .behind-row span:nth-child(3) {
      color: var(--kusabi-ink-dim);
    }

    .behind-tapes {
      display: grid;
      gap: 0.2rem;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 0.9rem;
    }

    .behind-tapes span {
      margin-right: 0.6rem;
      color: var(--kusabi-ink-dim);
      font-family: var(--font-mono);
      font-size: 0.78rem;
    }

    .dev-key {
      color: var(--kusabi-ink-dim);
      font-size: 0.82rem;
    }

    .dev-key summary {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      cursor: pointer;
    }

    .dev-key-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      align-items: center;
    }

    .dev-key-row input {
      min-height: 44px;
      padding: 0 0.7rem;
      border: 1px solid var(--kusabi-stone-line);
      background: rgba(0, 0, 0, 0.3);
      color: var(--kusabi-ink);
    }

    .dev-key-error {
      margin: 0.4rem 0 0;
      color: var(--kusabi-accent-bright);
    }

    @media (max-width: 560px) {
      .behind-row {
        grid-template-columns: minmax(0, 1fr) 3rem;
      }

      .behind-row span:nth-child(3) {
        grid-column: 1 / -1;
      }
    }
  </style>
</KusabiBaseLayout>
