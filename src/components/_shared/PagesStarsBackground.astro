---
// "Pages into stars" hub background: an open grimoire whose pages become stars, drawn on one canvas.
---
<div class="grimoire-scene" data-grimoire-scene aria-hidden="true">
  <canvas id="pages-stars-canvas"></canvas>
</div>

<style>
  .grimoire-scene {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
    background: linear-gradient(180deg, #03040f 0%, #120e3c 40%, #5c2069 70%, #d97f4e 92%, #efb06c 100%);
  }

  /* Touch browsers resize the viewport as the URL bar shows and hides; the largest viewport
     keeps the scene from being rebuilt on every scroll. */
  @media (pointer: coarse) {
    .grimoire-scene {
      inset: 0 0 auto 0;
      height: 100vh;
      height: 100lvh;
    }
  }

  .grimoire-scene canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import type { SceneHandle } from "../../scripts/_shared/scene-runtime";

  type PagesStarsWindow = Window & {
    __bindPagesStarsBg?: () => void;
    __pagesStarsBgCleanup?: () => void;
    __pagesStarsBgInitialized?: boolean;
  };

  const win = window as PagesStarsWindow;
  let live: { canvas: HTMLCanvasElement; handle: SceneHandle } | null = null;
  let pending: HTMLCanvasElement | null = null;

  const cleanup = () => {
    pending = null;
    live?.handle.destroy();
    live = null;
    win.__pagesStarsBgInitialized = false;
  };

  const bind = () => {
    const wrapper = document.getElementById("pages-stars-bg-container");
    const scene = wrapper?.querySelector<HTMLElement>("[data-grimoire-scene]");
    const canvas = scene?.querySelector<HTMLCanvasElement>("canvas");
    if (!wrapper || wrapper.style.display === "none" || !scene || !canvas) {
      cleanup();
      return;
    }
    if ((live && live.canvas === canvas) || pending === canvas) return;
    cleanup();
    pending = canvas;
    // The scene's code loads only when this theme is the one showing.
    void import("../../scripts/hub/grimoire-scene").then(({ createGrimoireScene }) => {
      if (pending !== canvas) return;
      pending = null;
      const handle = createGrimoireScene(canvas, scene, {
        avoid: ".hub-title-group, .hub-side-note, .hub-profile-widget, .hub-footer",
        avoidSoft: ".novel-card, .resume-card",
        pointerBlock: ".hub-title-group, .hub-side-note, .hub-profile-widget, .hub-footer, .novel-card, .resume-card, .hub-modal-overlay",
      });
      live = { canvas, handle };
      handle.start();
      win.__pagesStarsBgInitialized = true;
    });
  };

  win.__bindPagesStarsBg = bind;
  win.__pagesStarsBgCleanup = cleanup;
  bind();
</script>
