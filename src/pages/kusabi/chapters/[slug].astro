---
import { getCollection, render, type CollectionEntry } from "astro:content";
import EndOfTape from "../../../components/kusabi/reading/EndOfTape.astro";
import TapeHeader from "../../../components/kusabi/reading/TapeHeader.astro";
import { chapterLabel, EPILOGUE_NUMBER, PROLOGUE_NUMBER } from "../../../data/kusabi/chapter-label";
import { EPIGRAPHS } from "../../../data/kusabi/epigraphs";
import KusabiChapterLayout from "../../../layouts/kusabi/KusabiChapterLayout.astro";
import { withBase } from "../../../utils/base-path";

export async function getStaticPaths() {
  const chapters = (await getCollection("kusabiChapters")).sort((a, b) => a.data.number - b.data.number);
  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter, chapters },
  }));
}

interface Props {
  chapter: CollectionEntry<"kusabiChapters">;
  chapters: CollectionEntry<"kusabiChapters">[];
}

const { chapter, chapters } = Astro.props;
const { Content } = await render(chapter);
const number = chapter.data.number;
const index = chapters.findIndex((item) => item.id === chapter.id);
const previous = index > 0 ? chapters[index - 1] : undefined;
const next = index >= 0 ? chapters[index + 1] : undefined;
const label = chapterLabel(number);
const title = chapter.data.thaiTitle || chapter.data.title;
const special = number === PROLOGUE_NUMBER || number === EPILOGUE_NUMBER;
const reelMark = `ม้วนที่ ${String(number).padStart(2, "0")}`;
const eyebrow = special ? label : `${reelMark} · ${chapter.data.actTitle}`;
---

<KusabiChapterLayout
  title={`${label}: ${title} · บ้านคุซาบิบนเขาคุโระมิโซะ`}
  description={chapter.data.summary || `${label} ของบ้านคุซาบิบนเขาคุโระมิโซะ`}
  unitId={chapter.id}
  unitKind="chapter"
  number={number}
  unitTitle={title}
  act={chapter.data.act}
  musicCueId={chapter.data.musicCueId}
  epigraph={EPIGRAPHS[number]}
>
  <TapeHeader eyebrow={eyebrow} title={title} minutes={chapter.data.readingMinutes} hasCutscene={Boolean(EPIGRAPHS[number])} />
  <div class="kusabi-prose">
    <Content />
  </div>
  <EndOfTape
    label={special ? `จบ${label}` : `จบ${reelMark}`}
    previous={
      previous
        ? { href: withBase(`/kusabi/chapters/${previous.id}/`), detail: "ม้วนก่อนหน้า", label: chapterLabel(previous.data.number) }
        : { href: withBase("/kusabi/#kusabi-shelf"), detail: "กลับ", label: "ชั้นเทป" }
    }
    next={
      next
        ? { href: withBase(`/kusabi/chapters/${next.id}/`), detail: "ม้วนถัดไป", label: chapterLabel(next.data.number) }
        : { href: withBase("/kusabi/extra/"), detail: "ลิ้นชักล่าง", label: "ส่วนเสริม" }
    }
  />
</KusabiChapterLayout>
