---
// The chapter list as a shelf of tapes. Titles are not in this HTML: several name
// what happens (CH8 is literally "Risa is gone"), so a tape keeps a blank label
// until the reader reaches it and shelf.ts fills it in from the vault.
import { getCollection } from "astro:content";
import { chapterLabel, EPILOGUE_NUMBER, PROLOGUE_NUMBER } from "../../../data/kusabi/chapter-label";
import { EXTRA_UNITS } from "../../../data/kusabi/units";
import { withBase } from "../../../utils/base-path";

const chapters = (await getCollection("kusabiChapters")).sort((a, b) => a.data.number - b.data.number);
const shelves = [1, 2, 3].map((act) => ({
  act,
  tapes: chapters
    .filter((chapter) => chapter.data.act === act)
    .map((chapter) => ({
      id: chapter.id,
      number: chapter.data.number,
      minutes: chapter.data.readingMinutes ?? 3,
      label: chapterLabel(chapter.data.number),
      mark:
        chapter.data.number === PROLOGUE_NUMBER
          ? "นำ"
          : chapter.data.number === EPILOGUE_NUMBER
            ? "ท้าย"
            : String(chapter.data.number).padStart(2, "0"),
      // The opening tape names itself; the rest wait.
      title: chapter.data.number === PROLOGUE_NUMBER ? chapter.data.thaiTitle || chapter.data.title : "",
    })),
}));
const extraTotal = EXTRA_UNITS.length;
---

<section id="kusabi-shelf" class="shelf" aria-labelledby="shelf-heading">
  <header class="shelf-head">
    <p class="kusabi-kicker">Tape Shelf</p>
    <h2 id="shelf-heading">ชั้นเทป</h2>
    <p>ม้วนที่ยังไม่ถึงจะเป็นป้ายว่าง ป้ายจะเขียนขึ้นเองเมื่ออ่านมาถึงม้วนนั้น</p>
  </header>

  {
    shelves.map((shelf) => (
      <div class="shelf-row" data-shelf={shelf.act}>
        <h3 class="shelf-title">
          <span>ชั้นที่ {shelf.act}</span>
          <span class="shelf-name" data-shelf-name={shelf.act} />
        </h3>
        <ol class="tapes">
          {shelf.tapes.map((tape) => (
            <li class="tape" data-tape={tape.id} data-number={tape.number} data-state="idle" data-minutes={tape.minutes}>
              <a class="tape-link" href={withBase(`/kusabi/chapters/${tape.id}/`)} aria-label={tape.label} data-label={tape.label}>
                <span class="tape-mark" aria-hidden="true">{tape.mark}</span>
                <span class="tape-body">
                  <span class="tape-paper">
                    <span class="tape-title" data-tape-title>{tape.title}</span>
                  </span>
                  <span class="tape-wound" aria-hidden="true"><span class="tape-wound-fill" /></span>
                </span>
                <span class="tape-meta">
                  <span class="tape-minutes">{tape.minutes} นาที</span>
                  <span class="tape-stamp" data-tape-stamp hidden>ฟังแล้ว</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    ))
  }

  <div class="shelf-row shelf-lower">
    <h3 class="shelf-title"><span>ลิ้นชักล่าง</span></h3>
    <a class="drawer" href={withBase("/kusabi/extra/")} data-drawer>
      <span class="drawer-tapes" aria-hidden="true">
        {Array.from({ length: extraTotal }, () => <span class="drawer-tape" />)}
      </span>
      <span class="drawer-copy" data-drawer-copy>อีก {extraTotal} ม้วนยังไม่มีป้าย จะเปิดเมื่ออ่านบทส่งท้ายจบ</span>
    </a>
  </div>
</section>

<style>
  .shelf {
    position: relative;
    z-index: 5;
    width: min(860px, calc(100% - 32px));
    margin: 0 auto;
    padding: 5rem 0 3rem;
    scroll-margin-top: calc(var(--kusabi-topbar-height) + 0.5rem);
  }

  .shelf-head {
    display: grid;
    gap: 0.45rem;
    margin-bottom: 2.25rem;
  }

  .shelf-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    line-height: 1.25;
  }

  .shelf-head p:last-child {
    margin: 0;
    color: var(--kusabi-ink-dim);
    font-size: 0.95rem;
  }

  .shelf-row {
    margin-bottom: 2.5rem;
  }

  .shelf-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    margin: 0 0 0.7rem;
    color: var(--kusabi-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .shelf-name {
    color: var(--kusabi-ink);
    font-family: var(--font-hand);
    font-size: 1rem;
    letter-spacing: 0;
  }

  .tapes {
    display: grid;
    gap: 7px;
    margin: 0;
    padding: 10px;
    border: 1px solid var(--kusabi-stone-line);
    background: linear-gradient(180deg, rgba(36, 32, 29, 0.92), rgba(20, 17, 15, 0.94));
    box-shadow: inset 0 8px 16px rgba(0, 0, 0, 0.45);
    list-style: none;
  }

  .tape-link {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    min-height: 54px;
    padding: 6px 12px 6px 8px;
    border: 1px solid rgba(0, 0, 0, 0.55);
    background: linear-gradient(180deg, #2b2724, #1b1816);
    color: var(--kusabi-ink);
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }

  .tape-link:hover,
  .tape-link:focus-visible {
    background: linear-gradient(180deg, #37322e, #231f1c);
    transform: translateX(4px);
  }

  .tape-mark {
    color: var(--kusabi-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    text-align: center;
  }

  .tape-mark:lang(th) {
    font-size: 0.8rem;
  }

  .tape-body {
    display: grid;
    gap: 5px;
    min-width: 0;
  }

  .tape-paper {
    display: block;
    min-height: 1.75rem;
    padding: 2px 10px;
    background: var(--kusabi-label);
    color: var(--kusabi-label-ink);
    font-family: var(--font-hand);
    font-size: 1.02rem;
    line-height: 1.5;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
  }

  .tape[data-state="idle"] .tape-paper:has(.tape-title:empty) {
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0 11px,
      rgba(35, 30, 26, 0.16) 11px 12px
    );
    opacity: 0.55;
  }

  .tape-title {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tape-wound {
    display: block;
    height: 3px;
    background: rgba(255, 255, 255, 0.06);
  }

  .tape-wound-fill {
    display: block;
    width: calc(var(--tape-progress, 0) * 100%);
    height: 100%;
    background: var(--kusabi-ink-dim);
  }

  .tape[data-state="read"] .tape-wound-fill {
    background: var(--kusabi-accent);
  }

  .tape-meta {
    display: grid;
    gap: 1px;
    justify-items: end;
    min-width: 4.6rem;
    color: var(--kusabi-ink-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .tape-stamp {
    padding: 0 5px;
    border: 1px solid var(--kusabi-accent);
    color: var(--kusabi-accent-bright);
    font-family: var(--font-thai);
    font-size: 0.7rem;
    transform: rotate(-3deg);
  }

  .tape[data-state="current"] .tape-link {
    box-shadow: inset 2px 0 0 var(--kusabi-lamp);
  }

  .tape.is-recent .tape-link {
    animation: tape-recent 2.6s ease-out 1;
  }

  @keyframes tape-recent {
    0% {
      box-shadow: inset 2px 0 0 var(--kusabi-lamp), 0 0 0 1px var(--kusabi-lamp);
    }
    100% {
      box-shadow: inset 2px 0 0 var(--kusabi-lamp), 0 0 0 1px transparent;
    }
  }

  .drawer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.25rem;
    align-items: center;
    padding: 14px 16px;
    border: 1px dashed var(--kusabi-stone-3);
    background: rgba(20, 17, 15, 0.86);
    color: var(--kusabi-ink-dim);
    font-size: 0.92rem;
    text-decoration: none;
    transition: border-color 180ms, color 180ms;
  }

  .drawer:hover {
    border-color: var(--kusabi-ink-dim);
    color: var(--kusabi-ink);
  }

  .drawer-tapes {
    display: inline-flex;
    gap: 4px;
  }

  .drawer-tape {
    width: 9px;
    height: 34px;
    background: #2b2724;
    box-shadow: inset 0 9px 0 rgba(216, 209, 194, 0.3);
  }

  .drawer[data-open="true"] .drawer-tape {
    box-shadow: inset 0 9px 0 var(--kusabi-label);
  }

  @media (max-width: 560px) {
    .tapes {
      padding: 6px;
    }

    .tape-link {
      grid-template-columns: 2.1rem minmax(0, 1fr) auto;
      gap: 8px;
      padding-right: 8px;
    }

    .tape-meta {
      min-width: 3.4rem;
      font-size: 0.68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tape-link,
    .tape.is-recent .tape-link {
      transition: none;
      animation: none;
    }
  }
</style>
