---
// Firefly hub background on the scene kit (spec 2.13, 3.5): lamphu trees and fireflies
// by a canal at night. The theme CSS loads with the page so the first paint is themed;
// the scene module loads lazily when this theme is the one showing.
import "../../styles/_shared/hub-themes/firefly.css";
---

<div class="hub-sky hub-sky-firefly" data-hub-sky="firefly" aria-hidden="true">
  <canvas data-sky-static></canvas>
  <canvas data-sky-static></canvas>
  <canvas data-sky-static></canvas>
  <canvas data-sky-static></canvas>
  <canvas data-sky-live></canvas>
</div>

<style>
  /* The night sky itself; it is also the whole background until the first drawn frame,
     and stays if the scene fails. */
  .hub-sky-firefly {
    background:
      radial-gradient(ellipse 70% 40% at 62% 6%, rgb(32 52 78 / 0.55), transparent 70%),
      linear-gradient(180deg, #02050e 0%, #050b18 30%, #08142a 58%, #0b2133 82%, #0d2a36 100%);
  }

  /* Static planes are placed and sized by the scene (plane rects in px); the kit moves
     them with transforms. The live canvas covers the viewport. */
  .hub-sky-firefly canvas {
    position: absolute;
    display: block;
    max-width: none;
  }

  .hub-sky-firefly canvas[data-sky-static] {
    top: 0;
    left: 0;
    will-change: transform;
  }

  .hub-sky-firefly canvas[data-sky-live] {
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  // Types only: a type import is erased, so the kit and the scene stay out of the page bundle.
  import type { BindOptions, HubSceneHandle } from "../../scripts/hub/world/types";

  type SceneModule = typeof import("../../scripts/hub/firefly-scene");
  type FireflyWindow = Window & {
    __bindFireflyBg?: (options?: BindOptions) => void;
    __fireflyBgCleanup?: () => void;
    __fireflyBgInitialized?: boolean;
    __fireflyBgPreload?: () => Promise<SceneModule>;
    __hubSoftArrival?: boolean;
  };

  const win = window as FireflyWindow;
  let promise: Promise<SceneModule> | null = null;
  let live: { root: HTMLElement; handle: HubSceneHandle } | null = null;
  let pending: HTMLElement | null = null;

  // One cached dynamic import; a failed import is forgotten so the next bind or preload retries.
  const load = () =>
    (promise ??= import("../../scripts/hub/firefly-scene").catch((error: unknown) => {
      promise = null;
      throw error;
    }));

  const cleanup = () => {
    pending = null;
    live?.handle.destroy();
    live = null;
    win.__fireflyBgInitialized = false;
  };

  const bind = (options?: BindOptions) => {
    const wrapper = document.getElementById("firefly-bg-container");
    const root = wrapper?.querySelector<HTMLElement>("[data-hub-sky]");
    if (!wrapper || !root || getComputedStyle(wrapper).display === "none") {
      cleanup();
      return;
    }
    if (live?.root === root || pending === root) return;
    cleanup();
    pending = root;
    delete root.dataset.sceneFailed;
    load()
      .then(({ mount }) => {
        if (pending !== root) return;
        pending = null;
        const handle = mount(root, options);
        if (handle) live = { root, handle };
        else root.dataset.sceneFailed = "";
      })
      .catch((error: unknown) => {
        console.error(error);
        if (pending !== root) return;
        pending = null;
        root.dataset.sceneFailed = "";
      });
  };

  win.__bindFireflyBg = bind;
  win.__fireflyBgCleanup = cleanup;
  win.__fireflyBgPreload = load;
  bind({ softReturn: win.__hubSoftArrival === true });
</script>
