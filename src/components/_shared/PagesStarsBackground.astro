---
// Library hub background (pages-stars, spec 3.1 and 2.13): the sky root of the night reading
// hall. The theme CSS loads with the page; the scene loads lazily on the kit.
import "../../styles/_shared/hub-themes/pages-stars.css";
---

<div class="hub-sky hub-sky-pages-stars" data-hub-sky="pages-stars" aria-hidden="true">
  <canvas data-sky-static="hall"></canvas>
  <canvas data-sky-static="shelf-left"></canvas>
  <canvas data-sky-static="shelf-right"></canvas>
  <canvas data-sky-static="vault"></canvas>
  <canvas data-sky-live></canvas>
</div>

<style>
  .hub-sky-pages-stars {
    background:
      radial-gradient(ellipse 70% 40% at 32% 0%, rgb(24 32 74 / 0.55), transparent 70%),
      linear-gradient(180deg, #07060c 0%, #0d0b16 60%, #120d14 100%);
  }

  /* The scene sizes the static planes (gutter strips, the hall's scroll travel); the live canvas fills the root. */
  .hub-sky-pages-stars canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
  }

  .hub-sky-pages-stars canvas[data-sky-static="shelf-right"] {
    right: 0;
    left: auto;
  }

  .hub-sky-pages-stars canvas[data-sky-live] {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import type { BindOptions, HubSceneHandle } from "../../scripts/hub/world/types";

  type SceneModule = typeof import("../../scripts/hub/library-scene");
  type LibraryWindow = Window & {
    __bindPagesStarsBg?: (options?: BindOptions) => void;
    __pagesStarsBgCleanup?: () => void;
    __pagesStarsBgInitialized?: boolean;
    __pagesStarsBgPreload?: () => Promise<SceneModule>;
    __hubSoftArrival?: boolean;
  };

  const win = window as LibraryWindow;
  let promise: Promise<SceneModule> | null = null;
  let live: { root: HTMLElement; handle: HubSceneHandle } | null = null;
  let pending: HTMLElement | null = null;

  const load = () =>
    (promise ??= import("../../scripts/hub/library-scene").catch((error: unknown) => {
      promise = null;
      throw error;
    }));

  const cleanup = () => {
    pending = null;
    live?.handle.destroy();
    live = null;
    win.__pagesStarsBgInitialized = false;
  };

  const bind = (options?: BindOptions) => {
    const wrapper = document.getElementById("pages-stars-bg-container");
    const root = wrapper?.querySelector<HTMLElement>("[data-hub-sky]");
    if (!wrapper || !root || getComputedStyle(wrapper).display === "none") {
      cleanup();
      return;
    }
    if (live?.root === root || pending === root) return;
    cleanup();
    pending = root;
    delete root.dataset.sceneFailed;
    load()
      .then(({ mount }) => {
        if (pending !== root) return;
        pending = null;
        const handle = mount(root, options);
        if (handle) live = { root, handle };
        else root.dataset.sceneFailed = "";
      })
      .catch((error: unknown) => {
        console.error(error);
        if (pending !== root) return;
        pending = null;
        root.dataset.sceneFailed = "";
      });
  };

  win.__bindPagesStarsBg = bind;
  win.__pagesStarsBgCleanup = cleanup;
  win.__pagesStarsBgPreload = load;
  bind({ softReturn: win.__hubSoftArrival === true });
</script>
