---
import AscentHero from "../../components/sea/home/AscentHero.astro";
import SeaResume from "../../components/sea/home/SeaResume.astro";
import StrataToc from "../../components/sea/home/StrataToc.astro";
import SeaBaseLayout from "../../layouts/sea/SeaBaseLayout.astro";
import { SEA_ARCS } from "../../data/sea/arcs";
import { withBase } from "../../utils/base-path";
import { formatReadingTime } from "../../utils/reading-time";
import { getSeaChapters } from "../../utils/sea-chapters";
import { buildSeaToc } from "../../utils/sea-chapters-core";

const chapters = await getSeaChapters();
const strata = buildSeaToc(chapters, SEA_ARCS);
const published = chapters.filter((chapter) => chapter.data.draft !== true);

const prologue = chapters.find((chapter) => chapter.data.number === 0) ?? chapters[0];
const startHref = prologue ? withBase(`/sea/chapters/${prologue.id}/`) : withBase("/sea/#sea-toc");
const heroImage = withBase("/assets/sea/images/hero-sea-v2.webp");
const ceilingImage = withBase("/assets/sea/images/ceiling-plate.webp");

// The current arc is the latest one with a published chapter; its title is
// public by definition. Later arcs stay untitled (see StrataToc).
const currentArc = SEA_ARCS.find(
  (arc) => arc.number === Math.max(1, ...published.map((chapter) => chapter.data.arc)),
);
const totalChapters = Math.max(...SEA_ARCS.map((arc) => arc.chapterEnd));
const publishedMinutes = published.reduce((sum, chapter) => sum + chapter.data.readingMinutes, 0);
const facts = [
  `กำลังเผยแพร่ · อาร์กที่ ${currentArc?.number ?? 1}`,
  `${SEA_ARCS.length} อาร์ก · ${totalChapters} บท`,
  `อ่านได้แล้ว ${formatReadingTime(publishedMinutes)}`,
];
const arcLabel = currentArc ? `อาร์กที่ ${currentArc.number} · ${currentArc.titleTh}` : "";

const resumeUnits = chapters.map((chapter) => ({ id: chapter.id, number: chapter.data.number }));
---

<SeaBaseLayout
  title="ทะเลเหนือโลก — The Sea That Hung Above The World"
  description="เรื่องราวสยองขวัญทางนิเวศวิทยาเกี่ยวกับทะเลบนฟ้าและโรคปนเปื้อนน้ำเค็ม"
  bodyClass="sea-home-page"
  zone="elaris"
  musicCueId="sun-sheet"
>
  <link slot="head" rel="preload" as="image" href={heroImage} type="image/webp" fetchpriority="high" />
  <AscentHero
    startHref={startHref}
    heroImage={heroImage}
    ceilingImage={ceilingImage}
    facts={facts}
    arcLabel={arcLabel}
  >
    <SeaResume slot="resume" units={resumeUnits} />
  </AscentHero>
  <StrataToc strata={strata} showDraftBadges={!import.meta.env.PROD} />
</SeaBaseLayout>
