---
// Home hero of /sea/. Static markup is the complete tier C composition
// (reduced motion, motion off, no WebGL): the Elaris plate with the title
// block, then the narrative lines under a still of the water ceiling. Tiers A
// and B turn the section into a tall track with a sticky stage, and
// src/scripts/sea/home/ascent.ts scrubs the ascent through it.
import {
  SEA_HERO_EPIGRAPH,
  SEA_HERO_LINES,
  SEA_HERO_SOURCE_LABELS,
} from "../../../data/sea/hero-lines";

interface Props {
  startHref: string;
  heroImage: string;
  ceilingImage: string;
  /** Short facts under the actions, e.g. "กำลังเผยแพร่ · อาร์กที่ 1". */
  facts: string[];
  /** Kicker of the closing call to action, e.g. "อาร์กที่ 1 · ฝนที่พูดได้". */
  arcLabel: string;
}

const { startHref, heroImage, ceilingImage, facts, arcLabel } = Astro.props;
---

<section
  class="sea-ascent"
  data-sea-ascent
  data-tier="c"
  data-ceiling-plate={ceilingImage}
  style={`--sea-ceiling-image: url("${ceilingImage}")`}
  aria-labelledby="sea-title"
>
  <script is:inline>
    // Tier before first paint on a full load; SeaBaseLayout defines the check
    // and applies it itself on ClientRouter swaps. ascent.ts may only lower it.
    (() => {
      const root = document.currentScript && document.currentScript.parentElement;
      if (root && window.__seaAscentTier) root.dataset.tier = window.__seaAscentTier();
    })();
  </script>

  <div class="sea-ascent-stage">
    <div class="sea-ascent-scene" aria-hidden="true">
      <div class="sea-home-visual sea-ascent-plate" style={`--sea-home-hero-image: url("${heroImage}")`} transition:name="novel-hero-sea"></div>
      <div class="sea-ascent-shade"></div>
      <div class="sea-ascent-fog" data-zone="shroud">
        <span class="sea-fog sea-fog-low"></span>
        <span class="sea-fog sea-fog-mid"></span>
        <span class="sea-fog sea-fog-high"></span>
      </div>
      <div class="sea-ascent-still"></div>
      <canvas class="sea-ascent-ceiling"></canvas>
      <div class="sea-ascent-floor"></div>
    </div>

    <div class="sea-ascent-copy">
      <p class="sea-ascent-kicker" lang="en">The Sea That Hung Above The World</p>
      <h1 id="sea-title" class="sea-ascent-title">ทะเลเหนือโลก</h1>
      <figure class="sea-ascent-epigraph">
        <blockquote>
          <p>{SEA_HERO_EPIGRAPH.text}</p>
        </blockquote>
        <figcaption>{SEA_HERO_SOURCE_LABELS[SEA_HERO_EPIGRAPH.source]}</figcaption>
      </figure>
      <div class="sea-ascent-actions">
        <a class="sea-ascent-cta" href={startHref}>เริ่มอ่านบทนำ</a>
        <slot name="resume" />
      </div>
      <a class="sea-ascent-skip" href="#sea-toc">ข้ามไปสารบัญ <span aria-hidden="true">↓</span></a>
      <ul class="sea-ascent-facts">
        {facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>

    <ol class="sea-ascent-lines" aria-label="ถ้อยคำจากบทนำและบทที่ 1">
      {
        SEA_HERO_LINES.map((line) => (
          <li class="sea-ascent-line" data-stage={line.stage}>
            <span class="sea-line-text">{line.text}</span>
            <cite class="sea-line-source">{SEA_HERO_SOURCE_LABELS[line.source]}</cite>
          </li>
        ))
      }
    </ol>

    <!-- Inert until ascent.ts shows it at the end of the climb; tier "c" never does. -->
    <div class="sea-ascent-end" data-zone="air-shelf" inert>
      <p class="sea-ascent-end-kicker">{arcLabel}</p>
      <a class="sea-ascent-cta" href={startHref}>เริ่มอ่านบทนำ</a>
      <a class="sea-ascent-skip" href="#sea-toc">สารบัญ <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<script>
  import "../../../scripts/sea/home/ascent";
</script>

<style>
  /* The ceiling plate is a 1080x242 band. The static layers scale it to the
     width, never below its own size, and fade its lower edge into deep water
     instead of covering the box, which upscaled it several times. */
  .sea-ascent {
    --sea-ascent-ink: #eef4fb;
    --sea-plate-width: max(100vw, 1080px);
    --sea-plate-height: calc(var(--sea-plate-width) * 242 / 1080);
    --sea-plate-deep: #12444d;
    --sea-plate:
      linear-gradient(180deg, transparent 50%, var(--sea-plate-deep) calc(100% - 4px)) center top / var(--sea-plate-width) calc(var(--sea-plate-height) + 2px) no-repeat,
      var(--sea-ceiling-image) center top / var(--sea-plate-width) auto no-repeat,
      var(--sea-plate-deep);
    position: relative;
    isolation: isolate;
  }

  .sea-ascent-stage {
    position: relative;
    overflow: hidden;
  }

  .sea-ascent-scene {
    position: absolute;
    inset: 0 0 auto;
    height: 100svh;
    overflow: hidden;
    pointer-events: none;
  }

  .sea-ascent-plate {
    position: absolute;
    inset: -10% 0 -2%;
    transform-origin: 70% 92%;
    will-change: transform;
  }

  .sea-ascent-shade {
    position: absolute;
    inset: 0;
    opacity: 0;
    background:
      linear-gradient(180deg, rgba(1, 4, 8, 0.2) 0%, rgba(1, 4, 8, 0.55) 55%, rgba(1, 4, 8, 0.92) 100%);
  }

  .sea-ascent-fog,
  .sea-ascent-still,
  .sea-ascent-ceiling {
    position: absolute;
    inset: 0;
  }

  .sea-ascent-fog {
    pointer-events: none;
  }

  .sea-fog {
    position: absolute;
    inset: -12% -18%;
    opacity: 0;
    will-change: transform, opacity;
  }

  /* Banks of the Shroud: the shroud palette (data-zone) is cold pale grey-teal. */
  .sea-fog-low {
    background:
      radial-gradient(55% 30% at 28% 78%, color-mix(in srgb, var(--accent-cyan) 55%, transparent), transparent 72%),
      radial-gradient(60% 34% at 78% 70%, color-mix(in srgb, var(--accent-cyan) 45%, transparent), transparent 70%),
      linear-gradient(180deg, transparent 35%, color-mix(in srgb, var(--bg-sea-depth) 88%, transparent) 100%);
  }

  .sea-fog-mid {
    background:
      radial-gradient(70% 36% at 60% 50%, color-mix(in srgb, var(--accent-cyan) 60%, transparent), transparent 70%),
      radial-gradient(45% 28% at 18% 40%, color-mix(in srgb, var(--sea-ink) 30%, transparent), transparent 70%),
      linear-gradient(180deg, color-mix(in srgb, var(--bg-sea-night) 60%, transparent), color-mix(in srgb, var(--surface-sea) 85%, transparent));
  }

  .sea-fog-high {
    background:
      radial-gradient(80% 45% at 45% 22%, color-mix(in srgb, var(--sea-ink) 42%, transparent), transparent 72%),
      linear-gradient(180deg, color-mix(in srgb, var(--accent-cyan) 55%, var(--surface-sea)) 0%, color-mix(in srgb, var(--surface-sea) 70%, transparent) 70%, transparent);
  }

  .sea-ascent-ceiling {
    width: 100%;
    height: 100%;
  }

  /* Closes the stage into the table of contents as the ascent ends. */
  .sea-ascent-floor {
    position: absolute;
    inset: auto 0 0;
    height: 38%;
    opacity: 0;
    background: linear-gradient(180deg, transparent, rgba(3, 9, 11, 0.7) 55%, #03090b);
  }

  /* The still ceiling replaces the shader when it falls back (slow GPU,
     lost context); it opens from the top with the same reveal value. */
  .sea-ascent-still {
    display: none;
    opacity: var(--sea-reveal, 0);
    background:
      linear-gradient(180deg, transparent 40%, rgba(4, 16, 18, 0.9) 82%),
      var(--sea-plate);
    mask-image: linear-gradient(180deg, #000 calc(var(--sea-reveal, 0) * 85%), transparent calc(var(--sea-reveal, 0) * 85% + 15%));
  }

  .sea-ascent[data-ceiling="still"] .sea-ascent-still {
    display: block;
  }

  .sea-ascent[data-ceiling="still"] .sea-ascent-ceiling {
    display: none;
  }

  /* Title block: the first viewport. */
  .sea-ascent-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    width: min(100% - 2 * var(--sea-gutter), 1180px);
    margin: 0 auto;
    padding: calc(var(--sea-topbar-height) + 2rem) 0 clamp(2rem, 7svh, 4.5rem);
  }

  /* Contrast pool behind the copy; it moves and fades with it. */
  .sea-ascent-copy::before {
    position: absolute;
    z-index: -1;
    inset: auto -30vw -10svh -12vw;
    height: 90svh;
    content: "";
    background: radial-gradient(60% 55% at 28% 72%, rgba(2, 6, 10, 0.82), rgba(2, 6, 10, 0.5) 45%, transparent 75%);
    pointer-events: none;
  }

  .sea-ascent-copy.is-away {
    pointer-events: none;
  }

  .sea-ascent-kicker {
    margin: 0 0 0.35rem;
    color: color-mix(in srgb, var(--accent-cyan) 55%, var(--sea-ink));
    font-family: var(--font-display-sea);
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    font-style: italic;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  /* Cool light from the sea above on the top of the letters, a copper rim
     from the lamps below on their feet. background-clip: text only paints
     inside the padding box, so the extra block padding (cancelled by the
     negative margins) keeps Thai upper and lower vowels such as ื inside it. */
  .sea-ascent-title {
    margin: -0.3em 0 -0.1em;
    padding: 0.3em 0 0.18em;
    background: linear-gradient(
      180deg,
      #e6fcff 0%,
      var(--sea-ascent-ink) 46%,
      color-mix(in srgb, var(--accent-copper) 38%, var(--sea-ascent-ink)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: var(--font-thai);
    font-size: clamp(3.1rem, 10.5vw, 6.6rem);
    font-weight: 700;
    line-height: 1.12;
    filter: drop-shadow(0 0.35rem 1.4rem rgba(0, 0, 0, 0.55));
  }

  .sea-ascent-epigraph {
    max-width: 30rem;
    margin: 1rem 0 0;
    padding-left: 1rem;
    border-left: 1px solid color-mix(in srgb, var(--accent-cyan) 45%, transparent);
  }

  .sea-ascent-epigraph blockquote {
    margin: 0;
  }

  .sea-ascent-epigraph p {
    margin: 0;
    color: color-mix(in srgb, var(--sea-ascent-ink) 88%, var(--accent-cyan));
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    line-height: 1.7;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.75);
    text-wrap: balance;
  }

  .sea-ascent-epigraph figcaption {
    margin-top: 0.25rem;
    color: var(--sea-ink-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .sea-ascent-epigraph figcaption::before {
    content: "— ";
  }

  .sea-ascent-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.9rem;
    margin-top: 1.4rem;
  }

  .sea-ascent-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.55rem 1.35rem;
    border: 1px solid color-mix(in srgb, var(--accent-cyan) 60%, transparent);
    border-bottom-color: color-mix(in srgb, var(--accent-copper) 70%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--accent-cyan) 22%, rgba(2, 8, 12, 0.72)),
      rgba(2, 8, 12, 0.72)
    );
    box-shadow: 0 0 1.6rem color-mix(in srgb, var(--accent-cyan) 18%, transparent);
    color: var(--sea-ascent-ink);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none !important;
    transition: background-color 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .sea-ascent-cta:hover {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 2.2rem color-mix(in srgb, var(--accent-cyan) 32%, transparent);
    color: var(--sea-ascent-ink) !important;
  }

  .sea-ascent-skip {
    align-self: flex-start;
    margin-top: 1rem;
    color: color-mix(in srgb, var(--sea-ascent-ink) 80%, var(--sea-ink-muted));
    font-size: 0.9rem;
    text-underline-offset: 4px;
  }

  .sea-ascent-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.4rem;
    margin: 1rem 0 0;
    padding: 0.8rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--sea-ink-muted) 22%, transparent);
    color: color-mix(in srgb, var(--sea-ink-muted) 80%, var(--sea-ink));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    list-style: none;
  }

  /* Narrative lines: stacked prose in tier C, staged over the scene in A/B. */
  .sea-ascent-lines {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(2.2rem, 7svh, 4rem);
    justify-items: center;
    margin: 0;
    padding: clamp(6rem, 22svh, 11rem) var(--sea-gutter) clamp(4rem, 12svh, 7rem);
    list-style: none;
    background:
      linear-gradient(180deg, rgba(4, 12, 14, 0.2) 0%, color-mix(in srgb, var(--bg-sea-night) 92%, transparent) 62%, var(--bg-sea-night) 100%),
      var(--sea-plate);
    text-align: center;
  }

  .sea-ascent-line {
    display: grid;
    gap: 0.35rem;
    max-width: 34rem;
  }

  .sea-line-text,
  .sea-ascent-lines :global(.sea-line-glyphs) {
    color: var(--sea-ascent-ink);
    font-size: clamp(1.35rem, 4.2vw, 2.3rem);
    line-height: 1.55;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.8);
    text-wrap: balance;
  }

  .sea-ascent-lines :global(.sea-line-glyphs > span) {
    opacity: 0;
  }

  .sea-ascent-line[data-stage="shroud"] + .sea-ascent-line[data-stage="shroud"] {
    margin-top: calc(-1 * clamp(1.6rem, 5svh, 3rem));
  }

  /* Ink with a dark halo: the bright water stage behind it varies too much for a tinted caption. */
  .sea-line-source {
    color: color-mix(in srgb, var(--sea-ink) 80%, transparent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
    text-shadow: 0 1px 8px rgba(1, 4, 8, 0.8);
  }

  /* The shroud lines read as one passage: only the last one is cited. */
  .sea-ascent-line[data-stage="shroud"]:has(+ [data-stage="shroud"]) .sea-line-source {
    display: none;
  }

  .sea-ascent-end {
    display: none;
  }

  /* Live tiers: a tall track and a sticky stage. */
  .sea-ascent:is([data-tier="a"], [data-tier="b"]) {
    height: 320svh;
  }

  .sea-ascent[data-tier="b"] {
    height: 200svh;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-stage {
    position: sticky;
    top: 0;
    height: 100svh;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-scene {
    inset: 0;
    height: auto;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-copy {
    position: absolute;
    inset: 0;
    will-change: transform, opacity;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-lines {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    background: none;
    pointer-events: none;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-line {
    position: absolute;
    top: 34%;
    inset-inline: 0;
    width: min(34rem, 100% - 2 * var(--sea-gutter));
    margin-inline: auto;
    opacity: 0;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-line[data-stage="shroud"] {
    top: 28%;
    margin-top: 0;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-line[data-stage="shroud"] + [data-stage="shroud"] {
    top: 38%;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-line[data-stage="shroud"] + [data-stage="shroud"] + [data-stage="shroud"] {
    top: 48%;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-line[data-stage="ceiling"] {
    top: 48%;
  }

  .sea-ascent-line.is-split .sea-line-text {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-end {
    position: absolute;
    z-index: 3;
    inset-inline: 0;
    bottom: clamp(2.5rem, 11svh, 6rem);
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    width: min(26rem, 100% - 2 * var(--sea-gutter));
    margin-inline: auto;
    opacity: 0;
    text-align: center;
    pointer-events: none;
  }

  .sea-ascent-end.is-here {
    pointer-events: auto;
  }

  .sea-ascent-end-kicker {
    margin: 0;
    color: color-mix(in srgb, var(--accent-cyan) 60%, var(--sea-ink));
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .sea-ascent-end .sea-ascent-skip {
    align-self: center;
    margin-top: 0.2rem;
  }

  /* Keyboard focus always shows the control it lands on. */
  .sea-ascent-copy:focus-within {
    opacity: 1 !important;
    pointer-events: auto;
  }

  :global(body.sea-home-page[data-sea-hero="live"]) :global(.sea-rain-canvas) {
    z-index: 6;
  }

  @media (max-width: 760px) {
    .sea-ascent-plate {
      background-position: 74% center;
    }

    .sea-ascent-copy::before {
      inset: auto -20vw -6svh -20vw;
      height: 75svh;
      background: linear-gradient(180deg, transparent 0%, rgba(2, 6, 10, 0.72) 38%, rgba(2, 6, 10, 0.9) 100%);
    }

    .sea-ascent-epigraph {
      margin-top: 0.7rem;
    }

    .sea-ascent-actions {
      margin-top: 1.1rem;
    }

    .sea-ascent-skip {
      margin-top: 0.8rem;
    }
  }

  /* Landscape phones: the title block has to fit one short screen below the
     fixed top bar, so the type steps down with the viewport height and the
     facts row, repeated in the table of contents, is left out. */
  @media (orientation: landscape) and (max-height: 500px) {
    .sea-ascent-copy {
      justify-content: center;
      padding: calc(var(--sea-topbar-height) + 0.6rem) 0 0.9rem;
    }

    .sea-ascent-kicker {
      margin-bottom: 0.1rem;
      font-size: 0.7rem;
    }

    .sea-ascent-title {
      font-size: clamp(2rem, 12svh, 3rem);
    }

    .sea-ascent-epigraph {
      max-width: 38rem;
      margin-top: 0.35rem;
      padding-left: 0.8rem;
    }

    .sea-ascent-epigraph p {
      font-size: 0.92rem;
      line-height: 1.55;
    }

    .sea-ascent-epigraph figcaption {
      margin-top: 0.1rem;
      font-size: 0.7rem;
    }

    .sea-ascent-actions {
      margin-top: 0.75rem;
    }

    .sea-ascent-cta {
      padding-block: 0.45rem;
      font-size: 0.95rem;
    }

    .sea-ascent-skip {
      display: inline-flex;
      align-items: center;
      gap: 0.3em;
      min-height: 2.75rem;
      margin-top: 0.15rem;
    }

    .sea-ascent-facts {
      display: none;
    }

    .sea-line-text,
    .sea-ascent-lines :global(.sea-line-glyphs) {
      font-size: clamp(1.1rem, 6svh, 1.5rem);
      line-height: 1.45;
    }

    .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-line {
      width: min(40rem, 100% - 2 * var(--sea-gutter));
    }

    .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-line[data-stage="ceiling"] {
      top: 36%;
    }

    .sea-ascent:is([data-tier="a"], [data-tier="b"]) .sea-ascent-end {
      bottom: 0.9rem;
      gap: 0.3rem;
    }
  }
</style>
