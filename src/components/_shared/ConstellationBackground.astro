---
// Constellation hub background on the scene kit (spec 2.13, 3.3): a star plane the compositor
// moves, the live canvas, and the lazily loaded scene. The theme CSS is imported here so it is
// bundled into the hub page.
import "../../styles/_shared/hub-themes/constellation.css";
---

<div class="hub-sky hub-sky-constellation" data-hub-sky="constellation" aria-hidden="true">
  <canvas data-sky-static></canvas>
  <canvas data-sky-live></canvas>
</div>

<style>
  .hub-sky-constellation {
    background:
      radial-gradient(120% 60% at 50% 100%, rgba(58, 40, 52, 0.55), transparent 70%),
      linear-gradient(180deg, #04050b 0%, #070a16 40%, #0c1022 76%, #141528 100%);
  }

  .hub-sky-constellation canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The star plane tiles every viewport height; the kit moves it up by its parallax. */
  .hub-sky-constellation canvas[data-sky-static] {
    height: 200%;
  }
</style>

<script>
  import type { BindOptions, HubSceneHandle } from "../../scripts/hub/world/types";

  type SceneModule = typeof import("../../scripts/hub/lightfall-scene");
  type ConstellationWindow = Window & {
    __bindDynamicCityBg?: (options?: BindOptions) => void;
    __dynamicCityBgCleanup?: () => void;
    __dynamicCityBgInitialized?: boolean;
    __dynamicCityBgPreload?: () => Promise<SceneModule>;
    __hubSoftArrival?: boolean;
  };

  const win = window as ConstellationWindow;
  let promise: Promise<SceneModule> | null = null;
  let live: { root: HTMLElement; handle: HubSceneHandle } | null = null;
  let pending: HTMLElement | null = null;

  // One cached import; a failed import is forgotten so the next bind or preload retries.
  const load = () =>
    (promise ??= import("../../scripts/hub/lightfall-scene").catch((error: unknown) => {
      promise = null;
      throw error;
    }));

  const cleanup = () => {
    pending = null;
    live?.handle.destroy();
    live = null;
    win.__dynamicCityBgInitialized = false;
  };

  const bind = (options?: BindOptions) => {
    const wrapper = document.getElementById("constellation-bg-container");
    const root = wrapper?.querySelector<HTMLElement>("[data-hub-sky]");
    if (!wrapper || !root || getComputedStyle(wrapper).display === "none") {
      cleanup();
      return;
    }
    if (live?.root === root || pending === root) return;
    cleanup();
    pending = root;
    delete root.dataset.sceneFailed;
    load()
      .then(({ mount }) => {
        if (pending !== root) return;
        pending = null;
        const handle = mount(root, options);
        if (handle) live = { root, handle };
        else root.dataset.sceneFailed = "";
      })
      .catch((error: unknown) => {
        console.error(error);
        if (pending !== root) return;
        pending = null;
        root.dataset.sceneFailed = "";
      });
  };

  win.__bindDynamicCityBg = bind;
  win.__dynamicCityBgCleanup = cleanup;
  win.__dynamicCityBgPreload = load;
  bind({ softReturn: win.__hubSoftArrival === true });
</script>
