---
// The rail line of the /tsukinomi/ home concourse (design 4.4): a track through
// five stations, one per part, drawn as the reader scrolls (concourse.ts sets
// --rail-fill and lights the stations), with a marker on the furthest part the
// reader has read. Horizontal on wide screens, vertical in mobile portrait.
//
// The rail repeats what the departure board already says (each part's title)
// and carries no link, so it is hidden from assistive technology as a whole.
// Without script it is complete: every station lit, no marker.
import type { Palette } from "../../../scripts/tsukinomi/home/concourse-core";
import "../../../styles/tsukinomi/home.css";

export interface RailStation {
  part: number;
  label: string;
  title: string;
  englishTitle: string;
  palette: Palette;
}

interface Props {
  stations: readonly RailStation[];
}

const { stations } = Astro.props;
---

{
  stations.length > 0 && (
    <div class="tsuki-rail" data-rail aria-hidden="true">
      <div class="tsuki-rail-track">
        <span class="tsuki-rail-fill"></span>
        <span class="tsuki-rail-head"></span>
      </div>
      <ol class="tsuki-rail-stations" style={`--station-count:${stations.length}`}>
        {stations.map((station) => (
          <li class="tsuki-rail-station" data-part={station.part} data-palette={station.palette}>
            <span class="tsuki-rail-dot"></span>
            <svg class="tsuki-rail-marker" viewBox="0 0 24 24" width="24" height="24" focusable="false">
              <path d="M6 3h12a2 2 0 0 1 2 2v11a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V5a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="1.6" />
              <path d="M7.5 7h9v4h-9z" fill="currentColor" opacity="0.5" />
              <circle cx="8.5" cy="15" r="1.3" fill="currentColor" />
              <circle cx="15.5" cy="15" r="1.3" fill="currentColor" />
              <path d="M8 19.5 6.5 22M16 19.5 17.5 22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span class="tsuki-rail-name">
              <span class="tsuki-rail-part">{station.label}</span>
              <span class="tsuki-rail-title">{station.title}</span>
              <span class="tsuki-rail-english">{station.englishTitle}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  )
}
