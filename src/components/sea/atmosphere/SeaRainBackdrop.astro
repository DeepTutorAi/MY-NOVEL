<div class="sea-abyssal-mist" aria-hidden="true"></div>
<canvas class="sea-rain-canvas" aria-hidden="true"></canvas>

<style>
  .sea-abyssal-mist {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 30%, var(--bg-mist-radial-1) 0%, transparent 70%),
      radial-gradient(circle at 20% 80%, var(--bg-mist-radial-2) 0%, transparent 60%),
      linear-gradient(180deg, var(--bg-mist-linear-start) 0%, var(--bg-mist-linear-end) 100%);
    opacity: 0.85;
    transition: opacity 1s ease;
  }

  /* Reduced motion or the reader's motion toggle: one static, quieter mist. */
  .sea-abyssal-mist[data-motion="off"] {
    opacity: 0.6;
  }

  .sea-rain-canvas {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    width: 100%;
    height: 100%;
  }

  .sea-rain-canvas[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sea-abyssal-mist {
      transition: none;
    }
  }
</style>

<script>
  import { getAtmosphere, startAtmosphere } from "../../../scripts/sea/atmosphere/engine";
  import { onSeaPage } from "../../../scripts/sea/lifecycle";
  import { mountZoneShifts } from "../../../scripts/sea/reader/zone-shifts";
  import { isSeaZone } from "../../../data/sea/zones";

  onSeaPage("atmosphere", () => {
    // Zone shifts first, so the engine starts in the zone of a restored scroll position.
    const stopZoneShifts = mountZoneShifts();
    const canvas = document.querySelector<HTMLCanvasElement>(".sea-rain-canvas");
    const mist = document.querySelector<HTMLElement>(".sea-abyssal-mist");
    const atmosphere = canvas ? startAtmosphere({ canvas, mist }) : null;
    return () => {
      stopZoneShifts?.();
      atmosphere?.destroy();
    };
  });

  if (import.meta.env.DEV) {
    const debugWindow = window as Window & { __seaDebug?: Record<string, unknown> };
    const debug = (debugWindow.__seaDebug ??= {});
    debug.atmosphere = {
      stats: () => getAtmosphere()?.stats() ?? null,
      setZone: (zone: string) => {
        if (!isSeaZone(zone)) return false;
        document.body.dataset.zone = zone;
        window.dispatchEvent(new CustomEvent("sea:zone-change", { detail: zone }));
        return true;
      },
    };
  }
</script>
