---
import TsukinomiBaseLayout from "../../../layouts/tsukinomi/TsukinomiBaseLayout.astro";
import { SECTION_IDS, TOTAL_SECTIONS, UNLOCK_THRESHOLD } from "../../../scripts/tsukinomi/station-gates";
import "../../../styles/tsukinomi/extra-train.css";
---

<TsukinomiBaseLayout
  title="ส่วนเสริม — สถานีทะเลพระจันทร์"
  description="ขบวนพิเศษของสถานีทะเลพระจันทร์ เปิดเมื่ออ่านเรื่องไปไกลพอ"
  bodyClass="tsukinomi-extra-page section-home palette-autumn"
  sectionPalette="autumn"
  backgroundSlotId="hero-station"
>
  <main id="tsukinomi-main" class="xt" data-extra-root>
    {/* The sky (moonsea-loader.ts): empty, aria-hidden, fixed behind everything, never takes a pointer. */}
    <div class="tsuki-moonsea" aria-hidden="true" data-moonsea-mount></div>

    <section class="xt-gate" data-extra-gate aria-labelledby="xt-title">
      <p class="xt-kicker">Extra Train · <span lang="ja">臨時列車</span></p>
      <h1 id="xt-title">ขบวนพิเศษ</h1>

      <div class="xt-board" data-board>
        <div class="xt-board-head">
          <span aria-hidden="true" lang="ja">発車案内 <span class="xt-board-en">Departures</span></span>
          <span aria-hidden="true" data-board-now>--:--</span>
        </div>
        <div class="xt-board-row">
          <span class="xt-flaps" aria-hidden="true">
            {[..."--:--"].map((glyph) => <span class="xt-flap">{glyph}</span>)}
          </span>
          <span class="xt-board-name">ขบวนพิเศษ</span>
          <span class="xt-board-state">ยังไม่มีกำหนดออก</span>
        </div>
      </div>

      <p class="xt-lead">
        ขบวนนี้ไม่มีในตารางเวลา จะออกเมื่ออ่านอย่างน้อย {UNLOCK_THRESHOLD} จาก {TOTAL_SECTIONS} ภาค และต้องอ่านภาค {TOTAL_SECTIONS} แล้ว แต่ละภาคนับเมื่ออ่านจริงอย่างน้อย 18 นาที และผ่านเนื้อหาอย่างน้อย 80%
      </p>

      <ol class="xt-route" aria-label="ภาคที่อ่านแล้ว">
        {
          SECTION_IDS.map((id, index) => (
            <li class="xt-stop-mark" data-route-stop={id}>
              <span class="xt-stop-dot" aria-hidden="true" />
              ภาค {index + 1}
            </li>
          ))
        }
      </ol>
      <p class="xt-count" data-route-count>อ่านแล้ว 0 จาก {TOTAL_SECTIONS} ภาค</p>
      <p class="xt-error" role="status" data-extra-error hidden>เปิดขบวนนี้ไม่สำเร็จ ลองเปิดหน้านี้อีกครั้ง</p>

      <details class="xt-dev">
        <summary>ทางลัดผู้พัฒนา</summary>
        <div class="xt-dev-row">
          <label for="bypass-password">รหัส</label>
          <input id="bypass-password" type="password" autocomplete="off" data-bypass-input />
          <button type="button" data-bypass-btn>ปลดล็อก</button>
        </div>
        <p class="xt-error" role="status" data-bypass-error hidden>รหัสไม่ถูกต้อง</p>
      </details>
    </section>

    <div class="xt-run" data-train-run hidden>
      <section class="xt-view" data-train-view aria-labelledby="xt-train-title">
        <div class="xt-poles" aria-hidden="true" data-train-poles></div>
        <div class="xt-track" data-train-track>
          <div class="xt-seats" aria-hidden="true"></div>
        </div>
        <header class="xt-title">
          <h1 id="xt-train-title">ขบวนพิเศษ</h1>
          <span class="xt-kicker">Extra Train · <span lang="ja">臨時列車</span></span>
        </header>
        <p class="xt-hint" aria-hidden="true">เลื่อนหน้าลงให้รถวิ่ง · แตะภาพเพื่อดูเต็ม</p>
        <div class="xt-bar" aria-hidden="true"><span data-train-bar></span></div>
      </section>
    </div>

    <section class="xt-terminal" data-train-terminal aria-labelledby="xt-terminal-title" hidden>
      <p class="xt-kicker" lang="ja">終点</p>
      <h2 id="xt-terminal-title">ปลายทาง</h2>

      <h3>แนวคิดและความเหงาของสองฝั่งเวลา</h3>
      <p data-train-concept></p>

      <h3>รายการเพลงในม้วนเทป Walkman</h3>
      <ol class="xt-tracks" data-train-tracks></ol>

      <h3>บันทึกจากผู้ประพันธ์</h3>
      <blockquote class="xt-note" data-train-note></blockquote>
    </section>
  </main>

  <dialog class="xt-stop" data-train-stop aria-label="ภาพเต็ม">
    <figure>
      <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" />
      <figcaption></figcaption>
    </figure>
    <div class="xt-stop-actions">
      <button type="button" data-stop-step="-1">← ก่อนหน้า</button>
      <button type="button" data-stop-close>ปิด</button>
      <button type="button" data-stop-step="1">ถัดไป →</button>
    </div>
  </dialog>

  <script>
    import { onPage } from "../../../scripts/_shared/lifecycle";
    import "../../../scripts/tsukinomi/home/board-flaps";
    import { setupExtraTrain } from "../../../scripts/tsukinomi/extra-train";

    onPage("tsukinomi-extra-train", { bodyClass: "tsukinomi-extra-page" }, () => setupExtraTrain());
  </script>
</TsukinomiBaseLayout>
