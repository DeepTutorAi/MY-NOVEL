---
// Floating sonar button that opens the Current Rail & Sonar panel. Shown from
// 1024px up only: below that it would sit over the reading column, so the
// top bar's Sonar button takes over. The sweep and pulse animate only while
// audio plays and motion is allowed.
---

<button
  class="sonar-corner"
  type="button"
  data-sonar-corner
  data-playing="false"
  aria-label="เปิดแผงเสียงโซนาร์"
  aria-controls="sea-sonar-panel"
  aria-expanded="false"
>
  <span class="sonar-radar-pulse" aria-hidden="true"></span>
  <span class="sonar-radar-sweep" aria-hidden="true"></span>

  <span class="sonar-corner-art" aria-hidden="true">
    <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="50" cy="50" r="45" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" />
      <circle cx="50" cy="50" r="30" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" />
      <circle cx="50" cy="50" r="15" stroke="currentColor" stroke-width="1" />
      <line x1="50" y1="5" x2="50" y2="95" stroke="currentColor" stroke-width="0.5" opacity="0.3" />
      <line x1="5" y1="50" x2="95" y2="50" stroke="currentColor" stroke-width="0.5" opacity="0.3" />
      <circle cx="65" cy="35" r="2.5" fill="currentColor" class="sonar-blip blip-1" />
      <circle cx="35" cy="65" r="3" fill="currentColor" class="sonar-blip blip-2" />
      <line x1="50" y1="50" x2="50" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="sonar-needle" />
      <circle cx="50" cy="50" r="3" fill="currentColor" />
    </svg>
  </span>
</button>

<style>
  .sonar-corner {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    z-index: 22;
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border: 1px solid color-mix(in srgb, var(--accent-cyan) 45%, transparent);
    background: rgba(4, 8, 14, 0.94);
    border-radius: 999px;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.6);
    color: var(--sea-ink-muted);
    cursor: pointer;
    opacity: 0.9;
    overflow: hidden;
    transition:
      opacity 150ms ease,
      border-color 150ms ease,
      transform 150ms ease,
      color 150ms ease,
      box-shadow 150ms ease;
  }

  @media (max-width: 1023px) {
    .sonar-corner {
      display: none;
    }
  }

  .sonar-corner:hover,
  .sonar-corner:focus-visible,
  .sonar-corner[data-playing="true"],
  .sonar-corner[aria-expanded="true"] {
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    opacity: 1;
    box-shadow:
      0 0 16px color-mix(in srgb, var(--accent-cyan) 35%, transparent),
      0 0.5rem 2rem rgba(0, 0, 0, 0.7);
  }

  .sonar-corner:hover {
    transform: scale(1.06);
  }

  .sonar-corner:focus-visible {
    outline: 2px solid var(--accent-cyan);
    outline-offset: 3px;
  }

  .sonar-corner-art {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: 100%;
    padding: 10px;
  }

  .sonar-corner-art svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sonar-radar-pulse {
    position: absolute;
    inset: -1px;
    z-index: 3;
    border: 1.5px solid var(--accent-cyan);
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    box-shadow: inset 0 0 8px color-mix(in srgb, var(--accent-cyan) 30%, transparent);
  }

  .sonar-radar-sweep {
    position: absolute;
    inset: 4px;
    z-index: 1;
    border-radius: 50%;
    background: conic-gradient(
      from 270deg,
      transparent 0deg,
      color-mix(in srgb, var(--accent-cyan) 3%, transparent) 180deg,
      color-mix(in srgb, var(--accent-cyan) 15%, transparent) 270deg,
      var(--accent-cyan) 360deg
    );
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  .sonar-blip {
    opacity: 0;
  }

  .sonar-corner[data-playing="true"] .sonar-radar-sweep {
    opacity: 0.55;
  }

  .sonar-corner[data-playing="true"] .sonar-blip {
    opacity: 0.6;
  }

  /* Continuous motion only when the reader allows it. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-sea-motion="off"])) .sonar-corner[data-playing="true"] .sonar-radar-pulse {
      animation: sonar-pulse-anim 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    :global(html:not([data-sea-motion="off"])) .sonar-corner[data-playing="true"] .sonar-radar-sweep {
      opacity: 0.85;
      animation: sonar-sweep-spin 4s linear infinite;
    }

    :global(html:not([data-sea-motion="off"])) .sonar-corner[data-playing="true"] .sonar-needle {
      transform-origin: 50px 50px;
      animation: sonar-sweep-spin 4s linear infinite;
    }

    :global(html:not([data-sea-motion="off"])) .sonar-corner[data-playing="true"] .blip-1 {
      animation: sonar-blip-fade-1 4s linear infinite;
    }

    :global(html:not([data-sea-motion="off"])) .sonar-corner[data-playing="true"] .blip-2 {
      animation: sonar-blip-fade-2 4s linear infinite;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sonar-corner {
      transition: none;
    }

    .sonar-corner:hover {
      transform: none;
    }
  }

  @keyframes sonar-sweep-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sonar-pulse-anim {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.45);
      opacity: 0;
    }
  }

  @keyframes sonar-blip-fade-1 {
    0%, 12% { opacity: 0; }
    17% { opacity: 1; }
    30% { opacity: 0.15; }
    50%, 100% { opacity: 0; }
  }

  @keyframes sonar-blip-fade-2 {
    0%, 62% { opacity: 0; }
    67% { opacity: 1; }
    80% { opacity: 0.15; }
    95%, 100% { opacity: 0; }
  }
</style>
