---
import type { CollectionEntry } from "astro:content";
import TsukinomiCutscene from "../../components/tsukinomi/cutscene/TsukinomiCutscene.astro";
import SectionDropcap from "../../components/tsukinomi/reading/SectionDropcap.astro";
import { backgroundSlotIdForSection } from "../../data/tsukinomi/background-slots";
import { epigraphFor } from "../../scripts/tsukinomi/cutscene/epigraphs";
import { withBase } from "../../utils/base-path";
import "../../styles/tsukinomi/section.css";
import TsukinomiBaseLayout from "./TsukinomiBaseLayout.astro";

interface Props {
  section: CollectionEntry<"tsukinomiSections">;
}

const { section } = Astro.props;
const siteTitle = "สถานีทะเลพระจันทร์";
const pageTitle = `ภาค ${section.data.number}: ${section.data.title} — ${siteTitle}`;

const epigraphText = epigraphFor(section.data.number);
---

<TsukinomiBaseLayout
  title={pageTitle}
  description={section.data.summary}
  bodyClass={`tsukinomi-section-page section-${section.data.number} palette-${section.data.palette}`}
  sectionPalette={section.data.palette}
  musicCueId={section.data.musicCueId}
  backgroundSlotId={section.data.number === 0 ? "section-01" : backgroundSlotIdForSection(section.data.number)}
>
  {epigraphText && <TsukinomiCutscene part={section.data.number} epigraph={epigraphText} label={section.data.title} />}

  <main id="tsukinomi-main" class="tsukinomi-section-shell">
    <article
      class="tsukinomi-section"
      data-section-id={section.id}
      data-section-number={section.data.number}
      data-section-title={section.data.title}
      data-section-palette={section.data.palette}
      data-music-cue={section.data.musicCueId}
      style={`--tape-divider-mark: url("${withBase("/assets/tsukinomi/icons/tape-divider.svg")}")`}
    >
      <SectionDropcap />
      <slot />
    </article>
  </main>

  <div class="tsuki-unlock-toast" data-unlock-toast hidden role="status" aria-live="polite">
    <div class="tsuki-unlock-copy">
      <strong>🔓 ป้ายใหม่เปิดแล้ว</strong>
      <span>มีตัวละครเพิ่มในหน้าตัวละคร</span>
    </div>
    <a class="tsuki-unlock-go" href={withBase("/tsukinomi/characters/")}>ดู →</a>
    <button class="tsuki-unlock-close" type="button" data-unlock-close aria-label="ปิด">✕</button>
  </div>
</TsukinomiBaseLayout>

<script>
  // The opening cutscene (dialog rendered by TsukinomiCutscene.astro above).
  import "../../scripts/tsukinomi/cutscene/index";
</script>

<script>
  import { STOP_CHAPTERS } from "../../scripts/tsukinomi/station-gates";

  const SHOWN_KEY = "tsukinomi:characters:toast-chapter";

  // Shown once, when the chapter just finished opens a stop the reader has not been told about.
  document.addEventListener("tsukinomi:chapter-done", (event) => {
    const toast = document.querySelector("[data-unlock-toast]");
    if (!(toast instanceof HTMLElement)) return;
    const chapter = (event as CustomEvent<number>).detail;
    try {
      const shown = Number(localStorage.getItem(SHOWN_KEY)) || 0;
      if (chapter <= shown) return;
      localStorage.setItem(SHOWN_KEY, String(chapter));
      if (!STOP_CHAPTERS.some((stop) => stop > shown && stop <= chapter)) return;
    } catch {
      return; // localStorage blocked: silently skip the toast
    }
    toast.hidden = false;
    window.setTimeout(() => toast.classList.add("is-visible"), 30);
  });

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest("[data-unlock-close]")) return;
    const toast = event.target.closest<HTMLElement>("[data-unlock-toast]");
    if (!toast) return;
    toast.classList.remove("is-visible");
    window.setTimeout(() => {
      toast.hidden = true;
    }, 220);
  });
</script>

<style is:global>
  /* After the cutscene, focus returns to the section heading (or <main>), which
     only a script focuses: no tab stop, and no ring around a non-control. */
  .tsukinomi-section-shell [tabindex="-1"]:focus,
  .tsukinomi-section-shell:focus {
    outline: none;
  }

  .tsuki-unlock-toast {
    position: fixed;
    left: 50%;
    bottom: 1.4rem;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    max-width: min(26rem, calc(100vw - 2rem));
    padding: 0.85rem 1rem;
    border: 1px solid rgba(224, 163, 106, 0.4);
    background: rgba(20, 17, 12, 0.96);
    color: var(--tsuki-ink);
    box-shadow: 0 1.2rem 3.5rem rgba(0, 0, 0, 0.5);
    transform: translate(-50%, 1.6rem);
    opacity: 0;
    transition:
      transform 240ms ease,
      opacity 240ms ease;
  }

  .tsuki-unlock-toast.is-visible {
    transform: translate(-50%, 0);
    opacity: 1;
  }

  .tsuki-unlock-copy {
    display: grid;
    gap: 0.1rem;
  }

  .tsuki-unlock-copy strong {
    font-size: 0.92rem;
  }

  .tsuki-unlock-copy span {
    color: var(--tsuki-ink-dim);
    font-size: 0.78rem;
  }

  .tsuki-unlock-go {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--sunset);
  }

  .tsuki-unlock-close {
    background: none;
    border: none;
    color: var(--tsuki-ink-dim);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .tsuki-unlock-toast {
      transition: none;
    }
  }
</style>
